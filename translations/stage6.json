    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“呵呵，要去香格里拉耶～～”",
    "vi": "%s2%t4%z18%c1“Hí hí, sắp được đến Shangri-La rồi!”"
  },
  {
    "id": "stage6:1770",
    "token": 1770,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z20%c1“啦～啦啦～～”",
    "vi": "%s2%t4%z20%c1“La la la la~”"
  },
  {
    "id": "stage6:1795",
    "token": 1795,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“希蜜，我们不是去玩的。”",
    "vi": "%s2%t4%z18%c1“Shimi, bọn mình đâu có đi chơi.”"
  },
  {
    "id": "stage6:1825",
    "token": 1825,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“不要这样嘛！”",
    "vi": "%s2%t4%z18%c1“Đừng nghiêm túc thế mà!”"
  },
  {
    "id": "stage6:1836",
    "token": 1836,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“玩一下子不要紧吧！？”",
    "vi": "%s2%t4%z18%c1“Chơi một chút thôi thì có sao đâu!”"
  },
  {
    "id": "stage6:1861",
    "token": 1861,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“米雅法儿，你钱有带在身上吗？”",
    "vi": "%s2%t4%z18%c1“Miafa, cậu có mang tiền theo không?”"
  },
  {
    "id": "stage6:1900",
    "token": 1900,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“有¨¨¨”",
    "vi": "%s2%t4%z18%c1“Có...”"
  },
  {
    "id": "stage6:1925",
    "token": 1925,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“嗯，好。”",
    "vi": "%s2%t4%z18%c1“Ừ, tốt lắm.”"
  },
  {
    "id": "stage6:1936",
    "token": 1936,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“这次去我们要帮朋友买些土产回来，%N所以你的钱就不能乱花了知不知道。”",
    "vi": "%s2%t4%z18%c1“Lần này bọn mình phải mua đặc sản về cho bạn bè,%Nnên tiền của cậu không được tiêu lung tung đâu nhé!”"
  },
  {
    "id": "stage6:1961",
    "token": 1961,
    "call": "Say",
    "argument": 1,
    "mode": "locked",
    "source": "%s2%t4%z18%c1“¨¨¨¨¨”",
    "vi": ""
  },
  {
    "id": "stage6:1986",
    "token": 1986,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“有什么疑问吗？”",
    "vi": "%s2%t4%z18%c1“Có thắc mắc gì không?”"
  },
  {
    "id": "stage6:2011",
    "token": 2011,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“为什么是用我的钱呐¨¨¨”",
    "vi": "%s2%t4%z18%c1“Nhưng... sao lại dùng tiền của mình chứ...?”"
  },
  {
    "id": "stage6:2036",
    "token": 2036,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“呃¨¨¨”",
    "vi": "%s2%t4%z18%c1“Ơ... chuyện đó...”"
  },
  {
    "id": "stage6:2047",
    "token": 2047,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“这是为了你好¨¨¨”",
    "vi": "%s2%t4%z18%c1“Thì cũng là vì tốt cho cậu thôi mà...”"
  },
  {
    "id": "stage6:2072",
    "token": 2072,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“咦！？”",
    "vi": "%s2%t4%z18%c1“Hả!?”"
  },
  {
    "id": "stage6:2083",
    "token": 2083,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“为了我好？”",
    "vi": "%s2%t4%z18%c1“Vì tốt cho mình ư?”"
  },
  {
    "id": "stage6:2108",
    "token": 2108,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“嗯¨呃¨¨”",
    "vi": "%s2%t4%z18%c1“Ừm... à thì...”"
  },
  {
    "id": "stage6:2119",
    "token": 2119,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“因、因为有钱的人才能享有采购的乐趣呀！”",
    "vi": "%s2%t4%z18%c1“Vì... vì chỉ người có tiền mới được tận hưởng niềm vui mua sắm chứ!”"
  },
  {
    "id": "stage6:2130",
    "token": 2130,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“嗯¨¨¨对！就是这样子！！”",
    "vi": "%s2%t4%z18%c1“Ừ... đúng! Chính là thế đấy!”"
  },
  {
    "id": "stage6:2155",
    "token": 2155,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“哦¨¨¨”",
    "vi": "%s2%t4%z18%c1“Ồ...”"
  },
  {
    "id": "stage6:2166",
    "token": 2166,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“采购¨¨¨那好玩吗？”",
    "vi": "%s2%t4%z18%c1“Mua sắm... vui đến thế sao?”"
  },
  {
    "id": "stage6:2191",
    "token": 2191,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“哈哈哈，那你就问对人了！”",
    "vi": "%s2%t4%z18%c1“Ha ha, cậu hỏi đúng người rồi đấy!”"
  },
  {
    "id": "stage6:2202",
    "token": 2202,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“采购会让你得到败家的体验与快感，%N并且有满载而归的欣喜。”",
    "vi": "%s2%t4%z18%c1“Mua sắm cho cậu cảm giác tiêu tiền thỏa thích,%Nrồi sung sướng khi ôm cả đống đồ về nhà!”"
  },
  {
    "id": "stage6:2213",
    "token": 2213,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“哈哈～～”",
    "vi": "%s2%t4%z18%c1“Ha ha ha!”"
  },
  {
    "id": "stage6:2257",
    "token": 2257,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“妮雅你看，你看她们。”",
    "vi": "%s2%t4%z18%c1“Niya, nhìn kìa! Cậu nhìn bọn họ đi!”"
  },
  {
    "id": "stage6:2268",
    "token": 2268,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“我也想去玩嘛！”",
    "vi": "%s2%t4%z18%c1“Mình cũng muốn đi chơi cơ!”"
  },
  {
    "id": "stage6:2293",
    "token": 2293,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“不行¨¨，你是军人，她们不是。”",
    "vi": "%s2%t4%z18%c1“Không được. Cậu là quân nhân, còn họ thì không.”"
  },
  {
    "id": "stage6:2304",
    "token": 2304,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“所以不能学她们。”",
    "vi": "%s2%t4%z18%c1“Đừng có học theo họ.”"
  },
  {
    "id": "stage6:2329",
    "token": 2329,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“唔¨¨¨”",
    "vi": "%s2%t4%z18%c1“Hừm...”"
  },
  {
    "id": "stage6:2340",
    "token": 2340,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“好吧¨¨¨”",
    "vi": "%s2%t4%z18%c1“Thôi được...”"
  },
  {
    "id": "stage6:2365",
    "token": 2365,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“为了不让你整天只想着玩，%N邦联国信就放在你身上了！”",
    "vi": "%s2%t4%z18%c1“Để cậu khỏi suốt ngày chỉ nghĩ đến chơi bời,%Ntớ giao quốc thư Liên bang cho cậu giữ đấy!”"
  },
  {
    "id": "stage6:2376",
    "token": 2376,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“你要好好保管哦！”",
    "vi": "%s2%t4%z18%c1“Nhớ giữ cẩn thận nhé!”"
  },
  {
    "id": "stage6:2401",
    "token": 2401,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z24%c1“好～”",
    "vi": "%s2%t4%z24%c1“Được thôi~”"
  },
  {
    "id": "stage6:2412",
    "token": 2412,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“这样队长就换我当了对不对？”",
    "vi": "%s2%t4%z18%c1“Vậy tức là mình được làm đội trưởng rồi, phải không?”"
  },
  {
    "id": "stage6:2437",
    "token": 2437,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“你真的想太多了¨¨¨”",
    "vi": "%s2%t4%z18%c1“Cậu nghĩ xa quá rồi đấy...”"
  },
  {
    "id": "stage6:2476",
    "token": 2476,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“妮雅，你把东西交给希蜜，%N迟早会被她弄丢的。”",
    "vi": "%s2%t4%z18%c1“Niya, giao đồ cho Shimi giữ thì%Nsớm muộn gì cậu ấy cũng làm mất thôi.”"
  },
  {
    "id": "stage6:2501",
    "token": 2501,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“呃¨这个¨¨¨”",
    "vi": "%s2%t4%z18%c1“À... chuyện đó...”"
  },
  {
    "id": "stage6:2526",
    "token": 2526,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“不要那么不相信我嘛¨¨”",
    "vi": "%s2%t4%z18%c1“Đừng có thiếu lòng tin ở mình thế chứ...”"
  },
  {
    "id": "stage6:2551",
    "token": 2551,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“对呀，莉娜！”",
    "vi": "%s2%t4%z18%c1“Đúng đấy, Lina!”"
  },
  {
    "id": "stage6:2562",
    "token": 2562,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“希蜜姊姊虽然不聪明，%N但应该不会那么容易将东西弄丢呐！”",
    "vi": "%s2%t4%z18%c1“Chị Shimi tuy không được thông minh lắm,%Nnhưng chắc cũng chẳng dễ làm mất đồ đâu!”"
  },
  {
    "id": "stage6:2587",
    "token": 2587,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“这话说的¨¨¨”",
    "vi": "%s2%t4%z18%c1“Cậu nói thế thì...”"
  },
  {
    "id": "stage6:2612",
    "token": 2612,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“米雅¨¨¨”",
    "vi": "%s2%t4%z18%c1“Miafa...”"
  },
  {
    "id": "stage6:2623",
    "token": 2623,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“我怎么觉得你比我说得更讽刺¨¨”",
    "vi": "%s2%t4%z18%c1“Sao mình thấy cậu còn mỉa mai hơn cả mình vậy...”"
  },
  {
    "id": "stage6:2648",
    "token": 2648,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“没、没有呐¨¨¨”",
    "vi": "%s2%t4%z18%c1“Khô... không có đâu mà...”"
  },
  {
    "id": "stage6:2678",
    "token": 2678,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“姊妹们，又有猎物上门了。”",
    "vi": "%s2%t4%z18%c1“Chị em ơi, lại có con mồi tự tìm đến kìa!”"
  },
  {
    "id": "stage6:2703",
    "token": 2703,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“今天生意真好。”",
    "vi": "%s2%t4%z18%c1“Hôm nay làm ăn phát đạt thật đấy!”"
  },
  {
    "id": "stage6:2747",
    "token": 2747,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“她们是谁？”",
    "vi": "%s2%t4%z18%c1“Bọn họ là ai vậy?”"
  },
  {
    "id": "stage6:2772",
    "token": 2772,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“你不会自己过去问。”",
    "vi": "%s2%t4%z18%c1“Tự đến mà hỏi đi chứ!”"
  },
  {
    "id": "stage6:2817",
    "token": 2817,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s14%t4%z24%c1“请问～～”",
    "vi": "%s14%t4%z24%c1“Cho hỏi với~”"
  },
  {
    "id": "stage6:2828",
    "token": 2828,
