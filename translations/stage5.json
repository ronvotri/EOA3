  {
    "id": "stage5:2754",
    "token": 2754,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“妮雅～妮雅，路被封锁了怎么办？”",
    "vi": "%s2%t4%z18%c1“Niya ơi, Niya! Đường bị chặn rồi, làm sao đây?”"
  },
  {
    "id": "stage5:2779",
    "token": 2779,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“我们等晚上再过去吧¨¨”",
    "vi": "%s2%t4%z18%c1“Hay đợi đến tối rồi mình tìm cách qua nhé...”"
  },
  {
    "id": "stage5:2811",
    "token": 2811,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z30%c1“慢着！”",
    "vi": "%s2%t4%z30%c1“Đứng lại!”"
  },
  {
    "id": "stage5:2822",
    "token": 2822,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“你们两个小朋友打哪来的呀？”",
    "vi": "%s2%t4%z18%c1“Hai cô nhóc kia, ở đâu chui ra đấy?”"
  },
  {
    "id": "stage5:2847",
    "token": 2847,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“我才想问你们是打哪来的呢！”",
    "vi": "%s2%t4%z18%c1“Tôi còn muốn hỏi các người ở đâu chui ra đây này!”"
  },
  {
    "id": "stage5:2858",
    "token": 2858,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“一声不响就把村子的路都封起来了！”",
    "vi": "%s2%t4%z18%c1“Tự dưng kéo đến phong tỏa hết đường làng!”"
  },
  {
    "id": "stage5:2883",
    "token": 2883,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“我们是欧查军队，%N想要命的话就好好给我滚回家。”",
    "vi": "%s2%t4%z18%c1“Bọn ta là quân Ocha.%NMuốn giữ mạng thì mau cút về nhà!”"
  },
  {
    "id": "stage5:2908",
    "token": 2908,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“安¨安洁莉娜，别跟她们吵了，%N她们看起来不好惹呐。”",
    "vi": "%s2%t4%z18%c1“An... Angelina, đừng cãi nhau với họ nữa.%NTrông họ chẳng dễ chọc đâu...”"
  },
  {
    "id": "stage5:2933",
    "token": 2933,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z24%c1“开玩笑！难道我就好惹呀！”",
    "vi": "%s2%t4%z24%c1“Đùa à! Chẳng lẽ trông tôi dễ chọc lắm sao!?”"
  },
  {
    "id": "stage5:2958",
    "token": 2958,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“很好！你们两个胆子够大！”",
    "vi": "%s2%t4%z18%c1“Hay lắm! Hai đứa cũng gan đấy!”"
  },
  {
    "id": "stage5:2983",
    "token": 2983,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“我们是这个村子的人，你想怎样！？”",
    "vi": "%s2%t4%z18%c1“Bọn tôi là người làng này đấy! Thì sao nào!?”"
  },
  {
    "id": "stage5:3008",
    "token": 3008,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“不怎样，只是看到两个发育不完整的小朋友%N就想欺负。”",
    "vi": "%s2%t4%z18%c1“Chẳng sao cả. Thấy hai con nhóc còn chưa lớn%Nthì ta chỉ muốn bắt nạt một chút thôi.”"
  },
  {
    "id": "stage5:3033",
    "token": 3033,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z24%c1“啊！你讲话好毒。”",
    "vi": "%s2%t4%z24%c1“Á! Miệng lưỡi cô độc địa thật đấy!”"
  },
  {
    "id": "stage5:3058",
    "token": 3058,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“喔呵呵呵呵～～～我折磨人更毒。”",
    "vi": "%s2%t4%z18%c1“Ô hô hô hô! Ta hành hạ người còn ác hơn cơ!”"
  },
  {
    "id": "stage5:3069",
    "token": 3069,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“大家上，把这两个活捉，%N晚上就慢慢来折磨这两个丫头。”",
    "vi": "%s2%t4%z18%c1“Tất cả xông lên! Bắt sống hai đứa nó.%NTối nay ta sẽ từ từ hành hạ chúng!”"
  },
  {
    "id": "stage5:3094",
    "token": 3094,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“你太嚣张了¨¨¨",
    "vi": "%s2%t4%z18%c1“Ngươi quá ngông cuồng rồi...”"
  },
  {
    "id": "stage5:3105",
    "token": 3105,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“要打就来打！”",
    "vi": "%s2%t4%z18%c1“Muốn đánh thì nhào vô!”"
  },
  {
    "id": "stage5:3116",
    "token": 3116,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“不践踏一下你这虐待狂，%N难消我心头之火¨¨”",
    "vi": "%s2%t4%z18%c1“Không cho tên cuồng bạo hành như ngươi một trận%Nthì ta chẳng hả giận nổi!”"
  },
  {
    "id": "stage5:3155",
    "token": 3155,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“她们有危险了，要去帮忙吗？”",
    "vi": "%s2%t4%z18%c1“Họ gặp nguy rồi. Chúng ta có nên giúp không?”"
  },
  {
    "id": "stage5:3187",
    "token": 3187,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“嗯¨¨”",
    "vi": "%s2%t4%z18%c1“Ừm...”"
  },
  {
    "id": "stage5:3198",
    "token": 3198,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“看来她们也是受到欧查军攻击的受害者，%N我们去帮忙吧！”",
    "vi": "%s2%t4%z18%c1“Có vẻ họ cũng là nạn nhân của quân Ocha.%NMình mau đến giúp họ thôi!”"
  },
  {
