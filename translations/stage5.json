  {
    "id": "stage5:2167",
    "token": 2167,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“哼！刚刚居然输给那几个小鬼！。”",
    "vi": "%s2%t4%z18%c1“Hừ! Không ngờ ta lại thua mấy con nhóc đó!”"
  },
  {
    "id": "stage5:2178",
    "token": 2178,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“你们几个守住北边，%N这次绝不能让她们轻易离开。”",
    "vi": "%s2%t4%z18%c1“Các ngươi canh chặt phía bắc.%NLần này tuyệt đối không được để chúng thoát dễ dàng!”"
  },
  {
    "id": "stage5:2203",
    "token": 2203,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z30%c1“遵命！”",
    "vi": "%s2%t4%z30%c1“Tuân lệnh!”"
  },
  {
    "id": "stage5:2251",
    "token": 2251,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“你们负责封锁东北角，千万不能失误。”",
    "vi": "%s2%t4%z18%c1“Các ngươi phong tỏa góc đông bắc. Không được sơ suất!”"
  },
  {
    "id": "stage5:2276",
    "token": 2276,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z30%c1“是！”",
    "vi": "%s2%t4%z30%c1“Rõ!”"
  },
