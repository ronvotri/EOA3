  },
  {
    "id": "stage26:5884",
    "token": 5884,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“这里受到黑水感染的人不少，你一直在里头没%N事吧？”",
    "vi": "%s2%t4%z18%c1“Ở đây có rất nhiều người nhiễm nước đen.%NCậu ở giữa bọn họ suốt mà không sao chứ?”"
  },
  {
    "id": "stage26:5909",
    "token": 5909,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“哈哈，我混在她们里面好久动都不敢动呢！”",
    "vi": "%s2%t4%z18%c1“Ha ha! Tôi trà trộn trong đó lâu đến mức chẳng dám nhúc nhích!”"
  },
  {
    "id": "stage26:5920",
    "token": 5920,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“只是没想到在刚刚看到你们时，一高兴过头就%N露出马脚了！”",
    "vi": "%s2%t4%z18%c1“Ai ngờ vừa thấy mọi người, tôi mừng quá%Nnên lỡ để lộ thân phận!”"
  },
  {
    "id": "stage26:5945",
    "token": 5945,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“你没事就好了。”",
    "vi": "%s2%t4%z18%c1“May mà cậu vẫn bình an.”"
  },
  {
    "id": "stage26:5956",
    "token": 5956,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“还有其他没受感染的人吗？”",
    "vi": "%s2%t4%z18%c1“Còn ai chưa bị nhiễm bệnh không?”"
  },
  {
    "id": "stage26:5981",
    "token": 5981,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“在你们来到之前都没发现！”",
    "vi": "%s2%t4%z18%c1“Trước khi các cậu đến, tôi chưa thấy ai cả!”"
  },
  {
    "id": "stage26:6006",
    "token": 6006,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“这样呀¨¨¨¨”",
    "vi": "%s2%t4%z18%c1“Vậy sao...”"
  },
  {
    "id": "stage26:6017",
    "token": 6017,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“对了普兰可，我身旁的这位是妮雅，远从爱尔%N达来的使者。”",
    "vi": "%s2%t4%z18%c1“À, Planko! Đây là Niya, sứ giả%Nđến từ Elda xa xôi.”"
  },
  {
    "id": "stage26:6042",
    "token": 6042,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“妮雅您好，我是普兰可，柯凡迪雅神殿的守护%N者。”",
    "vi": "%s2%t4%z18%c1“Chào cô Niya. Tôi là Planko,%Nngười bảo vệ Đền Covandia.”"
  },
  {
    "id": "stage26:6067",
    "token": 6067,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“他们手上拥有能够净化天使之泉的镇魂剂，这%N次来到玛雅是特别来帮助我们净化天使之泉的。”",
    "vi": "%s2%t4%z18%c1“Đoàn của cô ấy có Thuốc Trấn Hồn để thanh tẩy suối Thiên Sứ.%NHọ đặc biệt đến Maya để giúp chúng ta!”"
  },
  {
    "id": "stage26:6092",
    "token": 6092,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“真的吗！？”",
    "vi": "%s2%t4%z18%c1“Thật sao!?”"
  },
  {
    "id": "stage26:6103",
    "token": 6103,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“那么施惠者，一切拜托你们了。”",
    "vi": "%s2%t4%z18%c1“Vậy xin nhờ các ân nhân giúp đỡ!”"
  },
  {
    "id": "stage26:6114",
    "token": 6114,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“有许多爱尔达人已经受到黑水严重控制，她们%N现在全都聚集在荷洛卡斯大神殿。”",
    "vi": "%s2%t4%z18%c1“Rất nhiều người Elda đã bị nước đen khống chế.%NGiờ họ đều tập trung tại Đại Đền Holokas.”"
  },
  {
    "id": "stage26:6139",
    "token": 6139,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“荷洛卡斯大神殿！？”",
    "vi": "%s2%t4%z18%c1“Đại Đền Holokas ư!?”"
  },
  {
    "id": "stage26:6150",
    "token": 6150,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“那不就是圣地¨¨¨¨”",
    "vi": "%s2%t4%z18%c1“Chẳng phải đó chính là thánh địa sao...?”"
  },
  {
    "id": "stage26:6175",
    "token": 6175,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“嗯，是呀！圣地被疫病者们占领了。”",
    "vi": "%s2%t4%z18%c1“Đúng vậy! Thánh địa đã rơi vào tay những kẻ nhiễm bệnh.”"
  },
  {
    "id": "stage26:6186",
    "token": 6186,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“让我加入你们一起打倒疫病者吧！”",
    "vi": "%s2%t4%z18%c1“Cho tôi đi cùng đánh đuổi bọn họ nhé!”"
  },
  {
    "id": "stage26:6211",
    "token": 6211,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“不行¨¨¨”",
    "vi": "%s2%t4%z18%c1“Không được...”"
  },
  {
    "id": "stage26:6236",
    "token": 6236,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“为什么！？”",
    "vi": "%s2%t4%z18%c1“Tại sao!?”"
  },
  {
    "id": "stage26:6247",
    "token": 6247,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“为什么不让我帮忙？”",
    "vi": "%s2%t4%z18%c1“Sao không cho tôi giúp một tay?”"
  },
  {
    "id": "stage26:6272",
    "token": 6272,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“你有更重要的事要做。”",
    "vi": "%s2%t4%z18%c1“Cậu còn việc quan trọng hơn phải làm.”"
  },
  {
    "id": "stage26:6283",
    "token": 6283,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“你必须趁现在疫病者都聚集在圣地的时候，拿%N着镇魂剂将各地天使之泉净化。”",
    "vi": "%s2%t4%z18%c1“Nhân lúc những kẻ nhiễm bệnh đang tụ tập ở thánh địa,%Ncậu phải mang Thuốc Trấn Hồn đi thanh tẩy các dòng suối.”"
  },
  {
    "id": "stage26:6294",
    "token": 6294,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
