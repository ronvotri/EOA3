  },
  {
    "id": "stage26:5220",
    "token": 5220,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s6%t4%z18%c1“这¨¨惨了¨¨¨¨¨¨”",
    "vi": "%s6%t4%z18%c1“Chết... chết rồi...”"
  },
  {
    "id": "stage26:5231",
    "token": 5231,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“帕托克～～曼宁～～～救人呀！”",
    "vi": "%s2%t4%z18%c1“Patok! Manning! Cứu người với!”"
  },
  {
    "id": "stage26:5261",
    "token": 5261,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“那不是神殿守护者普兰可吗！？”",
    "vi": "%s2%t4%z18%c1“Kia chẳng phải Planko, người bảo vệ ngôi đền sao!?”"
  },
  {
    "id": "stage26:5272",
    "token": 5272,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“我们快去帮忙吧！”",
    "vi": "%s2%t4%z18%c1“Mau đến giúp cô ấy!”"
  },
  {
    "id": "stage26:5297",
    "token": 5297,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“好！大家一口气击败她们！”",
    "vi": "%s2%t4%z18%c1“Được! Mọi người hợp sức đánh bại chúng nào!”"
  },
  {
