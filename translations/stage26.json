    "token": 4926,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“果然已经来不及，神殿被占据了。”",
    "vi": "%s2%t4%z18%c1“Đúng là không kịp rồi. Ngôi đền đã bị chiếm mất!”"
  },
  {
    "id": "stage26:4970",
    "token": 4970,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“这神殿¨¨¨热得令人窒息¨¨¨¨”",
    "vi": "%s2%t4%z18%c1“Ngôi đền này... nóng đến nghẹt thở...”"
  },
  {
    "id": "stage26:5030",
    "token": 5030,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“帕托克，你们终于来了！”",
    "vi": "%s2%t4%z18%c1“Patok! Cuối cùng các cậu cũng tới rồi!”"
  },
