    "vi": ""
  },
  {
    "id": "stage14:4174",
    "token": 4174,
    "call": "MessageBox",
    "argument": 0,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“加百列～萨维尔皇城”",
    "vi": "%s2%t4%z18%c1“Kinh thành Savel, Gabriel”"
  },
  {
    "id": "stage14:4190",
    "token": 4190,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“这场收复疆土的战役，你们赢得非常的漂亮。”",
    "vi": "%s2%t4%z18%c1“Các ngươi đã thắng một trận giành lại lãnh thổ thật đẹp mắt.”"
  },
  {
    "id": "stage14:4201",
    "token": 4201,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“无法与你们同在拉锡叶击退欧查军，这点确实%N让我感到相当遗憾。”",
    "vi": "%s2%t4%z18%c1“Tiếc là ta không thể sát cánh cùng các ngươi%Nđánh đuổi Ocha khỏi Laxia.”"
  },
  {
    "id": "stage14:4212",
    "token": 4212,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“不过接下来的任务仍是相当重要的，我们必须%N——将沙利叶、尤利尔、拉斐尔等各国收复。”",
    "vi": "%s2%t4%z18%c1“Nhưng nhiệm vụ tiếp theo cũng rất quan trọng.%NChúng ta phải giành lại Sariel, Uriel, Raphael và các nước khác.”"
  },
  {
    "id": "stage14:4237",
    "token": 4237,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“那么拉锡叶各地的修复工作¨¨¨”",
    "vi": "%s2%t4%z18%c1“Vậy còn việc khôi phục các vùng ở Laxia...?”"
  },
  {
    "id": "stage14:4262",
    "token": 4262,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“拉锡叶事战的修复工作你可以放心交给本国，%N已收复的邦联国家，我会尽可能协助建设与%N防御的。”",
    "vi": "%s2%t4%z18%c1“Cứ yên tâm giao việc tái thiết Laxia cho Gabriel.%NTa sẽ cố giúp xây dựng và bảo vệ những nước Liên bang%Nđã được giải phóng.”"
  },
  {
    "id": "stage14:4287",
    "token": 4287,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“多谢女帝！”",
    "vi": "%s2%t4%z18%c1“Xin đa tạ Nữ hoàng!”"
  },
  {
    "id": "stage14:4312",
    "token": 4312,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“另外，黑色天使之泉变成之事你是否听说？”",
    "vi": "%s2%t4%z18%c1“Nhân tiện, ngươi đã nghe chuyện suối Thiên Sứ hóa đen chưa?”"
  },
  {
    "id": "stage14:4337",
    "token": 4337,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“有的，队伍中的盈月等人曾提起。”",
    "vi": "%s2%t4%z18%c1“Có ạ. Yingyue và vài người trong đội từng nhắc tới.”"
  },
  {
    "id": "stage14:4362",
    "token": 4362,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“这是件很重要的事情。”",
    "vi": "%s2%t4%z18%c1“Đó là chuyện vô cùng nghiêm trọng.”"
  },
  {
    "id": "stage14:4373",
    "token": 4373,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“最近收到的一些消息，欧查军队中许多人正大%N量喝下成分不明的黑色泉水。”",
    "vi": "%s2%t4%z18%c1“Theo tin gần đây, rất nhiều lính Ocha đang uống%Nmột loại nước suối đen không rõ thành phần.”"
  },
  {
    "id": "stage14:4384",
    "token": 4384,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“虽然还不知道喝下后会发生什么病变，不过我%N担心将会酿出某些灾难。”",
    "vi": "%s2%t4%z18%c1“Ta chưa biết nó sẽ khiến cơ thể biến đổi ra sao,%Nnhưng e rằng có thể gây ra tai họa.”"
  },
  {
    "id": "stage14:4395",
    "token": 4395,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“由于加百列的泉水目前仍属于正常，所以我敬%N告你们在这段时间，千万不要喝下来路不明的泉%N水。”",
