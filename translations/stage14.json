  {
    "id": "stage14:3300",
    "token": 3300,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“终于到首都了！”",
    "vi": "%s2%t4%z18%c1“Cuối cùng cũng về tới kinh đô rồi!”"
  },
  {
    "id": "stage14:3340",
    "token": 3340,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“可恶的欧查军¨¨¨”",
    "vi": "%s2%t4%z18%c1“Lũ quân Ocha đáng ghét...”"
  },
  {
    "id": "stage14:3351",
    "token": 3351,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“看着吧，我不会再让你们嚣张下去了！”",
    "vi": "%s2%t4%z18%c1“Cứ chờ đấy! Ta sẽ không để các ngươi lộng hành nữa!”"
  },
  {
    "id": "stage14:3381",
    "token": 3381,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“哼！居然自动送上门来。”",
    "vi": "%s2%t4%z18%c1“Hừ! Lại tự dẫn xác tới đây à?”"
  },
  {
    "id": "stage14:3392",
    "token": 3392,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“那就等着被消灭吧！”",
    "vi": "%s2%t4%z18%c1“Vậy thì chuẩn bị chịu chết đi!”"
  },
  {
    "id": "stage14:3430",
    "token": 3430,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“玛西亚首领，放心好了！”",
    "vi": "%s2%t4%z18%c1“Thủ lĩnh Marcia, cứ yên tâm!”"
  },
  {
    "id": "stage14:3441",
    "token": 3441,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“虽然雷丝曼没有出席在这场战役，不过只要有%N我在，同样会让敌人闻风丧胆。”",
    "vi": "%s2%t4%z18%c1“Tuy Resman không tham chiến lần này,%Nnhưng chỉ cần có tôi, quân địch cũng đủ khiếp vía rồi!”"
  },
  {
    "id": "stage14:3466",
    "token": 3466,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“嗯，克诺依德，一切看你的表现了。”",
    "vi": "%s2%t4%z18%c1“Được. Konoid, ta trông vào bản lĩnh của ngươi đấy.”"
  },
  {
    "id": "stage14:3491",
    "token": 3491,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“就交给我吧！”",
    "vi": "%s2%t4%z18%c1“Cứ giao cho tôi!”"
  },
  {
