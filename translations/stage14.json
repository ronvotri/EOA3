    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“居然一再地失败¨¨¨”",
    "vi": "%s2%t4%z18%c1“Sao chúng ta cứ thất bại mãi thế này...”"
  },
