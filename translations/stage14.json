  {
    "id": "stage14:3983",
    "token": 3983,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“战、战胜了¨¨¨¨”",
    "vi": "%s2%t4%z18%c1“Th... thắng rồi...”"
  },
  {
    "id": "stage14:3994",
    "token": 3994,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“真的¨¨战胜欧查军了¨¨¨¨”",
    "vi": "%s2%t4%z18%c1“Thật sự... đánh bại quân Ocha rồi...”"
  },
  {
    "id": "stage14:4019",
    "token": 4019,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“太好了，这样战争是不是就结束了。”",
    "vi": "%s2%t4%z18%c1“Tốt quá! Vậy chiến tranh kết thúc rồi phải không?”"
  },
  {
    "id": "stage14:4044",
    "token": 4044,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“还没，我们仍然必须帮助复兴其他的邦联国。”",
    "vi": "%s2%t4%z18%c1“Chưa! Ta còn phải giúp các nước Liên bang khác hồi sinh.”"
  },
  {
    "id": "stage14:4055",
    "token": 4055,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“但是我们还是先将拉锡叶收复的好消息通知加%N百列女帝吧！”",
    "vi": "%s2%t4%z18%c1“Nhưng trước hết, phải báo tin Laxia được giải phóng%Ncho Nữ hoàng Gabriel đã!”"
  },
  {
    "id": "stage14:4080",
    "token": 4080,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“好～～”",
    "vi": "%s2%t4%z18%c1“Được~!”"
  },
