  {
    "id": "stage12:3489",
    "token": 3489,
    "call": "MessageBox",
    "argument": 0,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“加百列威尔港”",
    "vi": "%s2%t4%z18%c1“Cảng Will, Gabriel”"
  },
  {
    "id": "stage12:3505",
    "token": 3505,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“奇怪，为什么没有巡守的士兵呢？”",
    "vi": "%s2%t4%z18%c1“Lạ thật, sao không thấy lính tuần tra đâu nhỉ?”"
  },
  {
    "id": "stage12:3530",
    "token": 3530,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“难不成连这里都陷落！？”",
    "vi": "%s2%t4%z18%c1“Chẳng lẽ nơi này cũng đã thất thủ!?”"
  },
  {
    "id": "stage12:3541",
    "token": 3541,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“怪了¨¨¨”",
    "vi": "%s2%t4%z18%c1“Kỳ lạ thật...”"
  },
  {
    "id": "stage12:3566",
    "token": 3566,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“我们先往萨维尔皇城见加百列女帝吧。”",
    "vi": "%s2%t4%z18%c1“Cứ đến kinh thành Savel gặp Nữ hoàng Gabriel trước đã.”"
  },
  {
    "id": "stage12:3600",
    "token": 3600,
    "call": "PlayMusic",
    "argument": 0,
    "mode": "locked",
    "source": "Elder_D2.wav",
    "vi": ""
  },
  {
    "id": "stage12:3616",
    "token": 3616,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“连皇宫都没人！？”",
    "vi": "%s2%t4%z18%c1“Đến hoàng cung cũng chẳng có ai sao!?”"
  },
  {
    "id": "stage12:3641",
    "token": 3641,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“妮雅，那里有人。”",
    "vi": "%s2%t4%z18%c1“Niya, đằng kia có người kìa!”"
  },
  {
    "id": "stage12:3686",
    "token": 3686,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“请稍等。”",
    "vi": "%s2%t4%z18%c1“Xin đợi một chút!”"
  },
  {
    "id": "stage12:3711",
    "token": 3711,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“有什么事吗？”",
    "vi": "%s2%t4%z18%c1“Có chuyện gì vậy?”"
  },
  {
    "id": "stage12:3736",
    "token": 3736,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“究竟发生什么事了？”",
    "vi": "%s2%t4%z18%c1“Rốt cuộc đã xảy ra chuyện gì?”"
  },
  {
    "id": "stage12:3747",
    "token": 3747,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“为什么城里城外都没人！？”",
    "vi": "%s2%t4%z18%c1“Sao trong ngoài thành đều vắng tanh thế này!?”"
  },
  {
    "id": "stage12:3772",
    "token": 3772,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“大批的欧查军打算一举攻下加百列。”",
    "vi": "%s2%t4%z18%c1“Một đạo quân Ocha rất đông đang định đánh chiếm Gabriel.”"
  },
  {
    "id": "stage12:3783",
    "token": 3783,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“边境的部队实在抵挡不下，所以才连女帝也亲%N自上阵了。”",
    "vi": "%s2%t4%z18%c1“Quân ở biên giới không cầm cự nổi,%Nnên cả Nữ hoàng cũng đích thân ra trận rồi!”"
  },
  {
    "id": "stage12:3808",
    "token": 3808,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“那样¨¨¨拉锡叶？”",
    "vi": "%s2%t4%z18%c1“Vậy còn... Laxia thì sao?”"
  },
  {
    "id": "stage12:3833",
    "token": 3833,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“拉锡叶¨¨¨”",
    "vi": "%s2%t4%z18%c1“Laxia à...”"
  },
  {
    "id": "stage12:3844",
    "token": 3844,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“你们护卫队离开后不久，拉锡叶就完全被攻陷%N了。”",
    "vi": "%s2%t4%z18%c1“Không lâu sau khi đội cận vệ các cô lên đường,%NLaxia đã bị chiếm hoàn toàn rồi.”"
  },
  {
    "id": "stage12:3869",
    "token": 3869,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“什么！？”",
    "vi": "%s2%t4%z18%c1“Cái gì!?”"
  },
  {
    "id": "stage12:3880",
    "token": 3880,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“那¨¨¨贝拉肯女帝呢！？”",
    "vi": "%s2%t4%z18%c1“Vậy... Nữ hoàng Belaken đâu rồi!?”"
  },
  {
    "id": "stage12:3905",
    "token": 3905,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“对、对不起，我知道的不多。”",
    "vi": "%s2%t4%z18%c1“Tôi... tôi xin lỗi, tôi cũng không biết rõ.”"
  },
  {
    "id": "stage12:3916",
    "token": 3916,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“我得去为前线补给了。”",
    "vi": "%s2%t4%z18%c1“Tôi phải đem tiếp tế ra tiền tuyến đây.”"
  },
  {
    "id": "stage12:3941",
    "token": 3941,
    "call": "Say",
    "argument": 1,
    "mode": "locked",
    "source": "%s2%t4%z18%c1“¨¨¨”",
    "vi": ""
  },
  {
    "id": "stage12:3952",
    "token": 3952,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“我们先赶到边境去协助退敌吧。”",
    "vi": "%s2%t4%z18%c1“Trước hết ta tới biên giới giúp đẩy lùi quân địch đã!”"
  },
  {
    "id": "stage12:3977",
    "token": 3977,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“可是我们的国家¨¨¨”",
    "vi": "%s2%t4%z18%c1“Nhưng đất nước chúng ta...”"
  },
  {
    "id": "stage12:4002",
    "token": 4002,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“要收复拉锡叶，我们必须借住加百列的力量支%N撑才行，在其他国家都被占领的时候，这里是我%N们在爱尔达唯一的据点了。”",
    "vi": "%s2%t4%z18%c1“Muốn lấy lại Laxia, phải nhờ sức Gabriel.%NCác nước khác đều đã thất thủ, nên đây là cứ điểm%Nduy nhất của chúng ta còn lại tại Elda.”"
  },
  {
    "id": "stage12:4027",
    "token": 4027,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“妮雅说的是，即使大家现在都赶到拉锡叶，那%N么一旦加百列也陷落，我们人这么少绝对会被歼%N灭的。”",
    "vi": "%s2%t4%z18%c1“Niya nói đúng. Dù cả nhóm về Laxia bây giờ,%Nnếu Gabriel cũng thất thủ thì chỉ bấy nhiêu người%Nnhư chúng ta nhất định sẽ bị tiêu diệt.”"
  },
  {
    "id": "stage12:4052",
    "token": 4052,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“嗯，去前线协助退敌吧。”",
    "vi": "%s2%t4%z18%c1“Ừ, đến tiền tuyến giúp họ đánh lui quân địch thôi!”"
  },
  {
    "id": "stage12:4077",
    "token": 4077,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“要卖人情吗？这个我们拿手，走吧走吧！”",
    "vi": "%s2%t4%z18%c1“Đi giúp người để họ mang ơn à? Sở trường của ta đấy! Đi nào!”"
  },
  {
    "id": "stage12:4102",
    "token": 4102,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“别把军队跟小贼混在一起。”",
    "vi": "%s2%t4%z18%c1“Đừng đánh đồng quân đội với bọn trộm vặt.”"
  },
  {
    "id": "stage12:4127",
    "token": 4127,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“说什么！？你欠揍啊！”",
    "vi": "%s2%t4%z18%c1“Ngươi nói gì!? Muốn ăn đòn à!”"
  },
  {
    "id": "stage12:4152",
    "token": 4152,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“哼！”",
    "vi": "%s2%t4%z18%c1“Hừ!”"
  },
  {
    "id": "stage12:4186",
    "token": 4186,
    "call": "PlayMusic",
    "argument": 0,
    "mode": "locked",
    "source": "Battle_Elder01.wav",
    "vi": ""
  },
  {
    "id": "stage12:4202",
    "token": 4202,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z24%c1“全军开始第二波进攻！”",
    "vi": "%s2%t4%z24%c1“Toàn quân, mở đợt tấn công thứ hai!”"
  },
  {
    "id": "stage12:4213",
    "token": 4213,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z24%c1“拿下敌人首领者，依功论赏！”",
    "vi": "%s2%t4%z24%c1“Ai hạ được tướng địch sẽ được trọng thưởng!”"
  },
  {
    "id": "stage12:4238",
    "token": 4238,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“呵呵呵，那么谁都不要跟我抢！”",
    "vi": "%s2%t4%z18%c1“Hê hê, vậy thì đừng ai giành phần với ta!”"
  },
  {
    "id": "stage12:4268",
    "token": 4268,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“可恶，战力居然落差这么多。”",
    "vi": "%s2%t4%z18%c1“Khốn thật! Quân lực đôi bên chênh lệch quá lớn!”"
  },
  {
    "id": "stage12:4279",
    "token": 4279,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“打消耗战绝对没有胜算¨¨¨”",
    "vi": "%s2%t4%z18%c1“Đánh trận tiêu hao thế này chẳng thể thắng nổi...”"
  },
  {
    "id": "stage12:4314",
    "token": 4314,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“赫拉女帝！”",
    "vi": "%s2%t4%z18%c1“Nữ hoàng Hera!”"
  },
  {
    "id": "stage12:4325",
    "token": 4325,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“我们前来支援了。”",
    "vi": "%s2%t4%z18%c1“Chúng tôi đến tiếp viện đây!”"
  },
  {
    "id": "stage12:4350",
    "token": 4350,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“妮雅！？”",
    "vi": "%s2%t4%z18%c1“Niya!?”"
  },
  {
    "id": "stage12:4361",
    "token": 4361,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“太好了，你们来的正是时候。”",
    "vi": "%s2%t4%z18%c1“Tốt quá! Các ngươi đến đúng lúc lắm!”"
  },
  {
    "id": "stage12:4372",
    "token": 4372,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“敌人攻势太强，先一起将欧查军击退吧！”",
    "vi": "%s2%t4%z18%c1“Địch tấn công dữ dội quá! Hãy cùng ta đẩy lùi Ocha!”"
  },
  {
    "id": "stage12:4397",
    "token": 4397,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“交给我们了！”",
