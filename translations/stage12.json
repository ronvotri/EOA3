  },
  {
    "id": "stage12:5230",
    "token": 5230,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“幸好你们及时赶到，要是再晚一步，加百列随%N时都可能沦陷。”",
    "vi": "%s2%t4%z18%c1“May mà các ngươi đến kịp. Chỉ chậm thêm chút nữa,%NGabriel đã có thể thất thủ rồi.”"
  },
  {
    "id": "stage12:5241",
    "token": 5241,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“现阶段北方各国都已经被殴查军占据了，南方%N仅存本国及雷米尔还有少许战力抵抗。”",
    "vi": "%s2%t4%z18%c1“Giờ các nước phương bắc đều bị quân Ocha chiếm đóng.%NPhương nam chỉ còn Gabriel và Remiel đủ sức kháng cự.”"
  },
  {
    "id": "stage12:5252",
    "token": 5252,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“对于拉锡叶沦陷我感到很遗憾，但如今也只能%N依赖邦联残存的兵力来收复爱尔达各国了。”",
    "vi": "%s2%t4%z18%c1“Ta rất tiếc về sự thất thủ của Laxia. Giờ chỉ có thể%Ntrông cậy vào tàn quân Liên bang để giành lại Elda.”"
  },
  {
    "id": "stage12:5277",
    "token": 5277,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“是¨¨¨”",
    "vi": "%s2%t4%z18%c1“Vâng...”"
  },
  {
    "id": "stage12:5302",
    "token": 5302,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“赫莉将军！”",
    "vi": "%s2%t4%z18%c1“Tướng quân Heli!”"
  },
  {
    "id": "stage12:5327",
    "token": 5327,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“属下在！”",
    "vi": "%s2%t4%z18%c1“Thần có mặt!”"
  },
  {
    "id": "stage12:5352",
    "token": 5352,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“从今天开始，我将你派驻在妮雅的邦联部队下%N，协助复兴邦联各国。”",
    "vi": "%s2%t4%z18%c1“Từ hôm nay, ta điều ngươi về dưới quyền chỉ huy của Niya,%Nhỗ trợ giải phóng các nước thuộc Liên bang.”"
  },
  {
    "id": "stage12:5363",
    "token": 5363,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“你有异议吗？”",
    "vi": "%s2%t4%z18%c1“Ngươi có ý kiến gì không?”"
  },
  {
    "id": "stage12:5388",
    "token": 5388,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“报告陛下，属下没有异议。”",
    "vi": "%s2%t4%z18%c1“Tâu Bệ hạ, thần không có ý kiến!”"
  },
  {
    "id": "stage12:5413",
    "token": 5413,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“很好，那么妮雅。”",
    "vi": "%s2%t4%z18%c1“Tốt lắm. Còn Niya!”"
  },
  {
    "id": "stage12:5438",
    "token": 5438,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“是！”",
    "vi": "%s2%t4%z18%c1“Thần đây!”"
  },
  {
    "id": "stage12:5463",
    "token": 5463,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“我现在就命你为邦联部队统帅，责任是击退欧%N查军并协助收复邦联各国。”",
    "vi": "%s2%t4%z18%c1“Ta phong ngươi làm Tổng chỉ huy quân Liên bang,%Ncó nhiệm vụ đẩy lùi Ocha và giải phóng các nước.”"
  },
  {
    "id": "stage12:5474",
    "token": 5474,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“你愿意为爱尔达邦联效劳吗？”",
    "vi": "%s2%t4%z18%c1“Ngươi có nguyện phục vụ Liên bang Elda không?”"
  },
  {
    "id": "stage12:5499",
    "token": 5499,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“属下愿意。”",
    "vi": "%s2%t4%z18%c1“Thần xin nhận nhiệm vụ!”"
  },
  {
    "id": "stage12:5524",
    "token": 5524,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“很好，今日邦联军以拉锡叶国居多，第一个收%N复点就从拉锡叶开始。”",
    "vi": "%s2%t4%z18%c1“Tốt! Quân Liên bang hiện chủ yếu là người Laxia,%Nvậy nơi đầu tiên cần giành lại chính là Laxia!”"
  },
  {
    "id": "stage12:5535",
    "token": 5535,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“祝福你们传回佳音。”",
    "vi": "%s2%t4%z18%c1“Ta chúc các ngươi sớm mang tin thắng trận về.”"
