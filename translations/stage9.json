    "source": "%s2%t4%z18%c1“哇～一片漆黑¨¨”",
    "vi": "%s2%t4%z18%c1“Trời ơi, tối đen như mực...”"
  },
  {
    "id": "stage9:1199",
    "token": 1199,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“安洁莉娜¨¨¨”",
    "vi": "%s2%t4%z18%c1“Angelina ơi...”"
  },
  {
    "id": "stage9:1210",
    "token": 1210,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“我怕黑呐¨¨¨¨”",
    "vi": "%s2%t4%z18%c1“Mình sợ bóng tối lắm...”"
  },
  {
    "id": "stage9:1235",
    "token": 1235,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“可是你也不要一直黏着我啦！”",
    "vi": "%s2%t4%z18%c1“Nhưng cậu cũng đừng bám lấy mình mãi như thế!”"
  },
  {
    "id": "stage9:1246",
    "token": 1246,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“感觉怪恶心的。”",
    "vi": "%s2%t4%z18%c1“Cứ thấy sởn cả da gà ấy!”"
  },
  {
    "id": "stage9:1271",
    "token": 1271,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“逃狱！”",
    "vi": "%s2%t4%z18%c1“Vượt ngục đi!”"
  },
  {
    "id": "stage9:1282",
    "token": 1282,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“你们觉得如何？”",
    "vi": "%s2%t4%z18%c1“Mọi người thấy sao?”"
  },
  {
    "id": "stage9:1307",
    "token": 1307,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“再被捉到会不会被杀呀！？”",
    "vi": "%s2%t4%z18%c1“Nếu bị bắt lại, có khi nào bị giết không!?”"
  },
  {
    "id": "stage9:1332",
    "token": 1332,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“呃¨¨¨”",
    "vi": "%s2%t4%z18%c1“Ơ... chuyện đó...”"
  },
  {
    "id": "stage9:1374",
    "token": 1374,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“安静，有人来了！”",
    "vi": "%s2%t4%z18%c1“Suỵt, im nào! Có người đến!”"
  },
  {
    "id": "stage9:1399",
    "token": 1399,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z24%c1“你们谁是带头的？”",
    "vi": "%s2%t4%z24%c1“Trong đám các ngươi, ai là kẻ cầm đầu?”"
  },
  {
    "id": "stage9:1424",
    "token": 1424,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“你猜猜！”",
    "vi": "%s2%t4%z18%c1“Đoán thử xem!”"
  },
  {
    "id": "stage9:1449",
    "token": 1449,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z24%c1“说不说？”",
    "vi": "%s2%t4%z24%c1“Có chịu khai không?”"
  },
  {
    "id": "stage9:1460",
    "token": 1460,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z24%c1“不说就一个个把你们拖去宰了！”",
    "vi": "%s2%t4%z24%c1“Không khai thì ta lôi từng đứa ra chém!”"
  },
  {
    "id": "stage9:1485",
    "token": 1485,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“呜啊～好恐怖！”",
    "vi": "%s2%t4%z18%c1“Á! Sợ quá đi!”"
  },
  {
    "id": "stage9:1510",
    "token": 1510,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z24%c1“说！带头的是谁？”",
    "vi": "%s2%t4%z24%c1“Nói mau! Ai cầm đầu?”"
  },
  {
    "id": "stage9:1535",
    "token": 1535,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“是妮雅啦！”",
    "vi": "%s2%t4%z18%c1“Là Niya đấy!”"
  },
  {
    "id": "stage9:1560",
    "token": 1560,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“对，妮雅！”",
    "vi": "%s2%t4%z18%c1“Đúng rồi, Niya!”"
  },
  {
    "id": "stage9:1585",
    "token": 1585,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“嗯¨¨妮¨¨”",
    "vi": "%s2%t4%z18%c1“Ừm... Ni...”"
  },
  {
    "id": "stage9:1610",
    "token": 1610,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“喂喂喂！你们太不够意思了吧！”",
    "vi": "%s2%t4%z18%c1“Này! Mấy cậu chơi kỳ quá đó!”"
  },
  {
    "id": "stage9:1645",
    "token": 1645,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“废话少说。”",
    "vi": "%s2%t4%z18%c1“Đừng nhiều lời nữa.”"
  },
  {
    "id": "stage9:1656",
    "token": 1656,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“出来！”",
    "vi": "%s2%t4%z18%c1“Ra ngoài!”"
  },
  {
    "id": "stage9:1681",
    "token": 1681,
    "call": "Say",
    "argument": 1,
    "mode": "locked",
    "source": "%s2%t4%z18%c1“¨¨¨¨”",
    "vi": ""
  },
  {
    "id": "stage9:1692",
    "token": 1692,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“出去就出去。”",
    "vi": "%s2%t4%z18%c1“Ra thì ra, có gì đâu!”"
  },
  {
    "id": "stage9:1755",
    "token": 1755,
    "call": "PlayMusic",
    "argument": 0,
    "mode": "locked",
    "source": "Shangri_La_City.wav",
    "vi": ""
  },
  {
    "id": "stage9:1771",
    "token": 1771,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“你叫做妮雅¨¨”",
    "vi": "%s2%t4%z18%c1“Ngươi tên Niya à...”"
  },
  {
    "id": "stage9:1782",
    "token": 1782,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“响马团就是你率领的吗？”",
    "vi": "%s2%t4%z18%c1“Ngươi chỉ huy băng cướp ngựa đó sao?”"
  },
  {
    "id": "stage9:1807",
    "token": 1807,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“响马！？”",
    "vi": "%s2%t4%z18%c1“Băng cướp ư!?”"
  },
  {
    "id": "stage9:1832",
    "token": 1832,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“狄道附近沙漠的强盗勾当。”",
    "vi": "%s2%t4%z18%c1“Bọn cướp hoành hành ở sa mạc gần Didao ấy.”"
  },
  {
    "id": "stage9:1843",
    "token": 1843,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“就是你们吗？”",
    "vi": "%s2%t4%z18%c1“Có phải chính các ngươi không?”"
  },
  {
    "id": "stage9:1868",
    "token": 1868,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“不，盗贼另有他人。”",
    "vi": "%s2%t4%z18%c1“Không ạ! Băng cướp là những kẻ khác.”"
  },
  {
    "id": "stage9:1879",
    "token": 1879,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“我们是从爱尔达前来的使者。”",
    "vi": "%s2%t4%z18%c1“Chúng tôi là sứ giả từ Liên bang Elda đến.”"
  },
  {
    "id": "stage9:1904",
    "token": 1904,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“使者？你有什么证明。”",
    "vi": "%s2%t4%z18%c1“Sứ giả? Có gì làm bằng chứng?”"
  },
  {
    "id": "stage9:1929",
    "token": 1929,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“证明¨¨¨”",
    "vi": "%s2%t4%z18%c1“Bằng chứng ạ...”"
  },
  {
    "id": "stage9:1940",
    "token": 1940,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“邦联议会的国信已经被盗贼抢走了，不过我%N还有一份坎维琪要交给陛下的信件¨¨”",
    "vi": "%s2%t4%z18%c1“Quốc thư của Hội đồng Liên bang đã bị bọn cướp lấy mất.%NNhưng tôi còn bức thư Kanviki nhờ trao cho Bệ hạ...”"
  },
  {
    "id": "stage9:1951",
    "token": 1951,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“不知是否¨¨¨”",
    "vi": "%s2%t4%z18%c1“Không biết liệu bức thư này...”"
  },
  {
    "id": "stage9:1976",
    "token": 1976,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“坎维琪！？”",
    "vi": "%s2%t4%z18%c1“Kanviki ư!?”"
  },
  {
    "id": "stage9:1987",
    "token": 1987,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“嗯，取来与朕看看。”",
    "vi": "%s2%t4%z18%c1“Ừm, đưa đây để trẫm xem.”"
  },
  {
    "id": "stage9:2001",
    "token": 2001,
    "call": "MessageBox",
    "argument": 0,
    "mode": "translate",
    "source": "数分钟后～",
    "vi": "Vài phút sau..."
  },
  {
    "id": "stage9:2017",
    "token": 2017,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“嗯¨¨原来如此。”",
    "vi": "%s2%t4%z18%c1“Ừm... Ra là vậy.”"
  },
  {
    "id": "stage9:2028",
    "token": 2028,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“有关于贵国的战事早已传遍各地。”",
    "vi": "%s2%t4%z18%c1“Chuyện chiến tranh ở nước ngươi đã truyền khắp nơi rồi.”"
  },
  {
    "id": "stage9:2039",
    "token": 2039,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“但是希望本国出兵的话¨¨¨”",
    "vi": "%s2%t4%z18%c1“Nhưng chuyện muốn nước ta xuất quân thì...”"
  },
  {
    "id": "stage9:2050",
    "token": 2050,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“你必须知道，本国并无插手邦联内战的权力，%N况且也没有平白将本国士兵交出去送命的道理。”",
    "vi": "%s2%t4%z18%c1“Ngươi phải hiểu, ta không có quyền xen vào nội chiến Liên bang.%NHuống chi đâu thể vô cớ đưa binh sĩ nước mình đi chịu chết.”"
  },
  {
    "id": "stage9:2075",
    "token": 2075,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“陛下说的是，只是¨¨”",
    "vi": "%s2%t4%z18%c1“Bệ hạ nói phải, nhưng...”"
  },
  {
    "id": "stage9:2100",
    "token": 2100,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“不必多说了！”",
    "vi": "%s2%t4%z18%c1“Không cần nói thêm!”"
  },
  {
    "id": "stage9:2111",
    "token": 2111,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“这样吧，本国近日正逢武斗大会竞赛，%N你们也参加比赛，”",
    "vi": "%s2%t4%z18%c1“Thế này nhé. Nước ta sắp tổ chức đại hội võ thuật.%NCác ngươi cứ thử tham gia xem sao.”"
  },
  {
    "id": "stage9:2122",
    "token": 2122,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“至少让我瞧瞧你们的能耐后再作决定吧。”",
    "vi": "%s2%t4%z18%c1“Ít nhất cũng cho trẫm xem bản lĩnh của các ngươi rồi trẫm mới quyết định.”"
  },
  {
    "id": "stage9:2147",
    "token": 2147,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“比武大会¨¨¨”",
    "vi": "%s2%t4%z18%c1“Đại hội võ thuật sao...”"
  },
  {
    "id": "stage9:2172",
    "token": 2172,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“待你参赛后便明了！”",
    "vi": "%s2%t4%z18%c1“Cứ tham gia rồi khắc biết!”"
  },
  {
    "id": "stage9:2197",
    "token": 2197,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“是¨¨”",
    "vi": "%s2%t4%z18%c1“Vâng ạ...”"
  },
