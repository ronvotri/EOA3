  {
    "id": "stage40:1533",
    "token": 1533,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z16%c1“嘿嘿，我们逃跑的技术还蛮厉害的！”",
    "vi": "%s2%t4%z16%c1“Hê hê, bọn mình chạy trốn cũng giỏi phết đấy chứ!”"
  },
  {
    "id": "stage40:1544",
    "token": 1544,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z16%c1“敌人想追都追不到呢！”",
    "vi": "%s2%t4%z16%c1“Địch có muốn đuổi cũng chẳng theo kịp!”"
  },
  {
    "id": "stage40:1569",
    "token": 1569,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“别讲这种丢人现眼的话了。”",
    "vi": "%s2%t4%z18%c1“Đừng khoe chuyện mất mặt thế chứ!”"
  },
  {
    "id": "stage40:1594",
    "token": 1594,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z16%c1“我是说真的嘛，敌人本来就比我们多了！”",
    "vi": "%s2%t4%z16%c1“Mình nói thật mà! Quân địch đông hơn bọn mình nhiều!”"
  },
