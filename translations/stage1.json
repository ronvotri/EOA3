    "source": "%s6%t4%z18%c1“呼¨¨呼¨¨¨¨”",
    "vi": "%s6%t4%z18%c1“Hộc... hộc...”"
  },
  {
    "id": "stage1:1550",
    "token": 1550,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s4%t4%z18%c1“呼¨¨¨¨”",
    "vi": "%s4%t4%z18%c1“Hộc... hộc...”"
  },
  {
    "id": "stage1:1607",
    "token": 1607,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t2%z18%c1“你¨¨还好吧！”",
    "vi": "%s2%t2%z18%c1“Cậu... vẫn ổn chứ?”"
  },
  {
    "id": "stage1:1632",
    "token": 1632,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“呼¨¨只是跑得有点喘，我没事的¨¨¨¨”",
    "vi": "%s2%t4%z18%c1“Hộc... Mình chỉ hơi mệt vì chạy thôi, không sao đâu...”"
  },
  {
    "id": "stage1:1643",
    "token": 1643,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s3%t2%z18%c1“只是¨¨不得了了！”",
    "vi": "%s3%t2%z18%c1“Nhưng... nguy to rồi!”"
  },
  {
    "id": "stage1:1668",
    "token": 1668,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t2%z18%c1“发生什么事了吗？”",
    "vi": "%s2%t2%z18%c1“Có chuyện gì vậy?”"
  },
  {
    "id": "stage1:1693",
    "token": 1693,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s3%t2%z18%c1“首都厄特¨¨厄特已经被占领了¨¨¨”",
    "vi": "%s3%t2%z18%c1“Kinh đô Ett... Ett đã bị chiếm rồi!”"
  },
  {
    "id": "stage1:1718",
    "token": 1718,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t2%z18%c1“什么！？”",
    "vi": "%s2%t2%z18%c1“Cái gì!?”"
  },
  {
    "id": "stage1:1743",
    "token": 1743,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s3%t2%z18%c1“我们一路¨¨从首都逃到这里¨¨¨¨”",
    "vi": "%s3%t2%z18%c1“Bọn mình phải chạy một mạch từ kinh đô đến tận đây...”"
  },
  {
    "id": "stage1:1768",
    "token": 1768,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t2%z18%c1“那¨¨女王呢？”",
    "vi": "%s2%t2%z18%c1“Thế... Nữ hoàng đâu?”"
  },
  {
    "id": "stage1:1793",
    "token": 1793,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s3%t2%z18%c1“放心¨¨%N护卫队已经保护女王撤至宾斯坦城了。”",
    "vi": "%s3%t2%z18%c1“Yên tâm, đội cận vệ đã hộ tống Nữ hoàng%Nđến thành Benstein an toàn rồi.”"
  },
  {
    "id": "stage1:1804",
    "token": 1804,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s3%t2%z18%c1“¨¨¨¨我必须先通知其他人，有两位同伴正%N在后方抵挡敌人替我争取时间。”",
    "vi": "%s3%t2%z18%c1“... Mình phải đi báo tin cho những người khác.%NHai đồng đội đang chặn địch phía sau để câu giờ cho mình.”"
  },
  {
    "id": "stage1:1829",
    "token": 1829,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t2%z18%c1“那你赶紧通知其她人吧，我会帮助她们的。”",
    "vi": "%s2%t2%z18%c1“Vậy cậu mau đi báo tin đi! Mình sẽ giúp hai người đó.”"
  },
  {
    "id": "stage1:1854",
    "token": 1854,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s3%t2%z18%c1“谢谢，愿生命女神保佑你。”",
    "vi": "%s3%t2%z18%c1“Cảm ơn cậu. Cầu Nữ thần Sinh Mệnh che chở cho cậu.”"
  },
  {
    "id": "stage1:1917",
    "token": 1917,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t2%z18%c1“怎么办，我的法术施不出来了啦！”",
    "vi": "%s2%t2%z18%c1“Làm sao đây? Mình không thi triển phép được nữa rồi!”"
  },
  {
    "id": "stage1:1942",
    "token": 1942,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t2%z18%c1“哈哈哈！今天就是你的忌日了。”",
    "vi": "%s2%t2%z18%c1“Ha ha ha! Hôm nay là ngày tận số của ngươi!”"
  },
  {
    "id": "stage1:1972",
    "token": 1972,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t2%z26%c1“纳命来吧！”",
    "vi": "%s2%t2%z26%c1“Nộp mạng đây!”"
  },
  {
    "id": "stage1:1997",
    "token": 1997,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t2%z18%c1“哼，你试试看呀！”",
    "vi": "%s2%t2%z18%c1“Hừ! Cứ thử xem!”"
  },
  {
    "id": "stage1:2029",
    "token": 2029,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s8%t2%z18%c1“呃¨¨¨”",
    "vi": "%s8%t2%z18%c1“Á...”"
  },
  {
    "id": "stage1:2061",
    "token": 2061,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t2%z18%c1“居然偷袭我妹妹，绝不原谅你！”",
    "vi": "%s2%t2%z18%c1“Dám đánh lén em gái ta à? Không tha cho ngươi đâu!”"
  },
  {
    "id": "stage1:2072",
    "token": 2072,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t2%z18%c1“看招！”",
    "vi": "%s2%t2%z18%c1“Đỡ chiêu này!”"
  },
  {
