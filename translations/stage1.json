    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t2%z18%c1“那我们该怎么办！？”",
    "vi": "%s2%t2%z18%c1“Vậy giờ bọn mình phải làm sao!?”"
