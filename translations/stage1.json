    "token": 764,
    "call": "SP_AddAction",
    "argument": 3,
    "mode": "translate",
    "source": "%s8%t4%z20“我恳求生命女神赐与我生存的力量与勇气，”",
    "vi": "%s8%t4%z20“Con xin Nữ thần Sinh Mệnh ban sức sống và lòng can đảm,”"
