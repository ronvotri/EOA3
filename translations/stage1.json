  {
    "id": "stage1:872",
    "token": 872,
    "call": "SP_AddAction",
    "argument": 3,
    "mode": "translate",
    "source": "%s6%t4%z18以欧查帝国为首的欧查叛军对爱尔达联邦发起的%N%N全面侵略行动持续十二年之后¨¨¨",
    "vi": "%s6%t4%z18Cuộc xâm lược Liên bang Elda do phe Ocha khởi xướng%N%Nkéo dài suốt mười hai năm..."
  },
  {
    "id": "stage1:944",
    "token": 944,
    "call": "SP_AddAction",
    "argument": 3,
    "mode": "translate",
    "source": "%s6%t4%z18最后一场战争在拉锡叶首都厄特终结，欧查联军败战后%N%N撤返回国¨¨",
    "vi": "%s6%t4%z18Trận chiến cuối tại Ett, kinh đô Laxia, kết thúc. Quân Ocha bại trận%N%Nvà rút về nước..."
  },
  {
    "id": "stage1:989",
    "token": 989,
    "call": "SP_AddAction",
    "argument": 3,
    "mode": "translate",
    "source": "%s6%t4%z18号称“欧查之剑”的贝力欧女王“伊丝塔”于战役中身亡。",
    "vi": "%s6%t4%z18Nữ hoàng Belio là Ishtar, người được mệnh danh “Lưỡi gươm Ocha”, tử trận."
  },
  {
    "id": "stage1:1034",
    "token": 1034,
    "call": "SP_AddAction",
    "argument": 3,
    "mode": "translate",
    "source": "%s6%t4%z18新女王玛西亚受封王位后，带领欧查三国重新加入%N%N邦联议会¨¨¨",
    "vi": "%s6%t4%z18Nữ hoàng mới Marcia kế vị, đưa ba nước Ocha trở lại%N%NHội đồng Liên bang..."
  },
