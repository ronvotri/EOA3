    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“终于回到家了。”",
    "vi": "%s2%t4%z18%c1“Cuối cùng cũng về nhà rồi!”"
  },
  {
    "id": "stage92:1422",
    "token": 1422,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“虽然整趟旅程都没找到葛瑞丝大主教，但仍然%N觉得这段路很值得。”",
    "vi": "%s2%t4%z18%c1“Dù cả chuyến đi không tìm được Đại Tổng giám mục Grace,%Nnhưng mình vẫn thấy chuyến này đáng lắm.”"
  },
  {
    "id": "stage92:1447",
    "token": 1447,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“嗯嗯！”",
    "vi": "%s2%t4%z18%c1“Ừ, đúng vậy!”"
  },
  {
    "id": "stage92:1458",
    "token": 1458,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“对了你们有时间也要来城里找我们哦！”",
    "vi": "%s2%t4%z18%c1“À, khi nào rảnh nhớ đến thành thăm bọn mình nhé!”"
  },
  {
    "id": "stage92:1483",
    "token": 1483,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“军队还缺人吗？”",
    "vi": "%s2%t4%z18%c1“Trong quân đội còn tuyển người không?”"
  },
  {
    "id": "stage92:1508",
    "token": 1508,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“咦！？”",
    "vi": "%s2%t4%z18%c1“Ơ!?”"
  },
  {
    "id": "stage92:1519",
    "token": 1519,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“你想加入吗？”",
    "vi": "%s2%t4%z18%c1“Cậu muốn gia nhập sao?”"
  },
  {
    "id": "stage92:1544",
    "token": 1544,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“如果哪天我失业的话¨¨¨”",
    "vi": "%s2%t4%z18%c1“Nếu có ngày mình thất nghiệp thì...”"
  },
  {
    "id": "stage92:1569",
    "token": 1569,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“那¨¨等你考虑清楚，随时欢迎你加入。”",
    "vi": "%s2%t4%z18%c1“Vậy... khi nào quyết định xong, cứ tới gia nhập nhé!”"
  },
  {
    "id": "stage92:1580",
    "token": 1580,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“希蜜！”",
    "vi": "%s2%t4%z18%c1“Shimi!”"
  },
  {
    "id": "stage92:1591",
    "token": 1591,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“我们也回首都吧！”",
    "vi": "%s2%t4%z18%c1“Bọn mình cũng về kinh đô thôi!”"
  },
  {
    "id": "stage92:1616",
    "token": 1616,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“好！”",
    "vi": "%s2%t4%z18%c1“Được!”"
  },
  {
    "id": "stage92:1641",
    "token": 1641,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“要保重哦！”",
    "vi": "%s2%t4%z18%c1“Nhớ giữ gìn sức khỏe nhé!”"
  },
  {
    "id": "stage92:1666",
    "token": 1666,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“你们也是。”",
    "vi": "%s2%t4%z18%c1“Mọi người cũng vậy!”"
