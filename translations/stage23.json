  {
    "id": "stage23:4312",
    "token": 4312,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“你们快点过来。”",
    "vi": "%s2%t4%z18%c1“Mau đến đây!”"
  },
  {
    "id": "stage23:4432",
    "token": 4432,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“嘿嘿！来追我呀～～”",
    "vi": "%s2%t4%z18%c1“Hê hê! Giỏi thì đuổi theo ta đi~!”"
  },
  {
    "id": "stage23:4537",
    "token": 4537,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“你¨¨你要趁机偷袭我们。”",
    "vi": "%s2%t4%z18%c1“Ngươi... ngươi định nhân cơ hội đánh lén chúng ta!”"
  },
  {
    "id": "stage23:4562",
    "token": 4562,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“别想太多，我只是来把洁莉带走的。”",
    "vi": "%s2%t4%z18%c1“Đừng nghĩ xa thế. Ta chỉ đến đưa Jeli về thôi.”"
  },
  {
    "id": "stage23:4592",
    "token": 4592,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“玛西亚姊姊你也来啦！%N你们都来追我呀！”",
    "vi": "%s2%t4%z18%c1“Chị Marcia cũng đến rồi à!%NMọi người cùng đuổi bắt em đi!”"
  },
  {
    "id": "stage23:4603",
    "token": 4603,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“哈哈哈哈哈～～”",
    "vi": "%s2%t4%z18%c1“Ha ha ha ha!”"
  },
  {
    "id": "stage23:4718",
    "token": 4718,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“你们是哪里来的，有喝下黑水吗？”",
    "vi": "%s2%t4%z18%c1“Các vị từ đâu tới? Đã uống nước đen chưa?”"
  },
  {
    "id": "stage23:4743",
    "token": 4743,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“我们是爱尔达人，%N我们并没有喝下黑色泉水。”",
    "vi": "%s2%t4%z18%c1“Chúng tôi đến từ Elda,%Nvà chưa từng uống nước suối đen.”"
  },
  {
    "id": "stage23:4754",
    "token": 4754,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“请问你是？”",
    "vi": "%s2%t4%z18%c1“Xin hỏi anh là ai?”"
  },
  {
    "id": "stage23:4779",
    "token": 4779,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“帕托克，玛雅人。”",
    "vi": "%s2%t4%z18%c1“Ta là Patok, người Maya.”"
  },
  {
    "id": "stage23:4790",
    "token": 4790,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“有族人从玛雅到了爱尔达来，%N我们是来将她们逐回的。”",
    "vi": "%s2%t4%z18%c1“Có người trong tộc tôi từ Maya sang Elda.%NChúng tôi đến để đưa họ trở về.”"
  },
  {
    "id": "stage23:4835",
    "token": 4835,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“我认得你，你是贝力欧的女帝。”",
    "vi": "%s2%t4%z18%c1“Ta biết cô. Cô là Nữ hoàng Belio.”"
  },
  {
    "id": "stage23:4860",
    "token": 4860,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“嗯！你没认错。”",
    "vi": "%s2%t4%z18%c1“Ừ, ngươi không nhận nhầm đâu.”"
  },
  {
    "id": "stage23:4885",
    "token": 4885,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“梅塔隆与亚伯登女帝已经在玛雅喝下太多黑水%N了。”",
    "vi": "%s2%t4%z18%c1“Nữ hoàng Metaron và Aberdon đã uống quá nhiều%Nnước đen ở Maya.”"
  },
  {
    "id": "stage23:4896",
    "token": 4896,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“还有一个贵族被她们带着，%N被迫喝下很多黑水，但我不认识她。”",
    "vi": "%s2%t4%z18%c1“Họ còn đem theo một nữ quý tộc khác,%Nép cô ấy uống rất nhiều nước đen. Ta không biết cô ấy là ai.”"
  },
  {
    "id": "stage23:4921",
    "token": 4921,
    "call": "Say",
    "argument": 1,
    "mode": "locked",
    "source": "%s2%t4%z18%c1“¨¨¨¨¨”",
    "vi": ""
  },
  {
    "id": "stage23:4932",
    "token": 4932,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“应该是萨梅尔女帝¨¨克诺依德¨¨¨”",
    "vi": "%s2%t4%z18%c1“Chắc là Nữ hoàng Samel... Konoid...”"
  },
  {
    "id": "stage23:4957",
    "token": 4957,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“她也是爱尔达国家的女帝？？”",
    "vi": "%s2%t4%z18%c1“Cô ấy cũng là Nữ hoàng một nước Elda sao?”"
  },
  {
    "id": "stage23:4982",
    "token": 4982,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“嗯！她是。”",
    "vi": "%s2%t4%z18%c1“Ừ, đúng vậy.”"
  },
  {
    "id": "stage23:5007",
    "token": 5007,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“你！还有你！”",
    "vi": "%s2%t4%z18%c1“Ngươi! Cả ngươi nữa!”"
  },
  {
    "id": "stage23:5018",
    "token": 5018,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“你怎么没受到黑水感染？”",
    "vi": "%s2%t4%z18%c1“Sao các ngươi không bị nước đen ảnh hưởng?”"
  },
  {
    "id": "stage23:5043",
    "token": 5043,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“之前有一点，现在已经解除了。”",
    "vi": "%s2%t4%z18%c1“Trước đây có đôi chút, giờ đã khỏi rồi.”"
  },
  {
    "id": "stage23:5068",
    "token": 5068,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“解除？可以说出如何解除吗？”",
    "vi": "%s2%t4%z18%c1“Khỏi ư? Có thể nói làm sao khỏi được không?”"
  },
  {
    "id": "stage23:5093",
    "token": 5093,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“你身后的人。”",
    "vi": "%s2%t4%z18%c1“Những người đứng phía sau ngươi ấy.”"
  },
  {
    "id": "stage23:5104",
    "token": 5104,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“她们有药剂。”",
    "vi": "%s2%t4%z18%c1“Họ có thuốc giải.”"
  },
  {
    "id": "stage23:5168",
    "token": 5168,
    "call": "Say",
    "argument": 1,
    "mode": "locked",
    "source": "%s2%t4%z18%c1“¨¨¨¨”",
    "vi": ""
  },
  {
    "id": "stage23:5179",
    "token": 5179,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“真的有解药？”",
    "vi": "%s2%t4%z18%c1“Thật sự có thuốc giải ư?”"
  },
  {
    "id": "stage23:5204",
    "token": 5204,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“是的，我们从香格里拉取的的镇魂剂，%N可以净化黑色天使之泉。”",
    "vi": "%s2%t4%z18%c1“Vâng, chúng tôi lấy Thuốc Trấn Hồn từ Shangri-La.%NThuốc có thể thanh tẩy suối Thiên Sứ đen.”"
  },
  {
    "id": "stage23:5229",
    "token": 5229,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“那么可以请你们帮忙吗？”",
    "vi": "%s2%t4%z18%c1“Vậy các người giúp chúng tôi được không?”"
  },
  {
    "id": "stage23:5240",
    "token": 5240,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“玛雅有多处天使之泉都是黑色的。”",
    "vi": "%s2%t4%z18%c1“Nhiều suối Thiên Sứ ở Maya cũng đã hóa đen.”"
  },
  {
    "id": "stage23:5265",
    "token": 5265,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“我们前来就是为了净化所有天使之泉的。”",
    "vi": "%s2%t4%z18%c1“Chúng tôi đến đây chính là để thanh tẩy tất cả các dòng suối.”"
  },
  {
    "id": "stage23:5290",
    "token": 5290,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“真的吗！？那我会带你们到玛雅！”",
    "vi": "%s2%t4%z18%c1“Thật sao!? Vậy tôi sẽ đưa các vị đến Maya!”"
  },
  {
    "id": "stage23:5315",
    "token": 5315,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“没问题。”",
    "vi": "%s2%t4%z18%c1“Không vấn đề gì.”"
  },
  {
    "id": "stage23:5326",
    "token": 5326,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“就请您带路了！”",
    "vi": "%s2%t4%z18%c1“Vậy nhờ anh dẫn đường!”"
  },
  {
    "id": "stage23:5384",
    "token": 5384,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“你们都抓不到我的。”",
    "vi": "%s2%t4%z18%c1“Chẳng ai bắt được ta đâu!”"
  },
  {
    "id": "stage23:5395",
    "token": 5395,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“哈哈哈哈哈～～”",
    "vi": "%s2%t4%z18%c1“Ha ha ha ha!”"
  },
