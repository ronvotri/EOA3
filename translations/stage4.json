    "call": "MessageBox",
    "argument": 0,
    "mode": "translate",
    "source": "Stage-4 前往加百列公国求援",
    "vi": "Màn 4 - Đến Công quốc Gabriel cầu viện"
  },
  {
    "id": "stage4:2342",
