  {
    "id": "stage15:3580",
    "token": 3580,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“总算将沙利叶收复了，补充军品后就往%N尤利尔出发吧！”",
    "vi": "%s2%t4%z18%c1“Cuối cùng cũng giành lại được Sariel! Tiếp tế xong%Nchúng ta lên đường đến Uriel nhé!”"
  },
  {
    "id": "stage15:3659",
    "token": 3659,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“米雅法儿，你有看到吗？”",
    "vi": "%s2%t4%z18%c1“Miafa, cậu thấy không?”"
  },
  {
    "id": "stage15:3670",
    "token": 3670,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“刚刚跑过去的好像是我们家隔壁的耶里朵？！”",
    "vi": "%s2%t4%z18%c1“Người vừa chạy qua kia giống Yerido ở cạnh nhà bọn mình quá!?”"
  },
  {
    "id": "stage15:3708",
    "token": 3708,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“你去哪？等等我呐！”",
    "vi": "%s2%t4%z18%c1“Cậu đi đâu thế? Chờ mình với!”"
  },
  {
    "id": "stage15:3753",
    "token": 3753,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“你们别脱队呀¨¨”",
    "vi": "%s2%t4%z18%c1“Đừng có tự ý tách đội như vậy chứ...”"
  },
  {
    "id": "stage15:3778",
    "token": 3778,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“有什么好东西居然不说清楚。”",
    "vi": "%s2%t4%z18%c1“Có thứ gì hay ho mà giấu kín thế nhỉ?”"
  },
  {
    "id": "stage15:3789",
    "token": 3789,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“嘿嘿！我也跟过去看看。”",
    "vi": "%s2%t4%z18%c1“Hê hê! Mình cũng qua xem thử!”"
  },
  {
    "id": "stage15:3827",
    "token": 3827,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“你们¨¨¨”",
    "vi": "%s2%t4%z18%c1“Mấy cậu thật là...”"
  },
  {
    "id": "stage15:3852",
    "token": 3852,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“哈哈，果然不是军队出身的人就是会这样¨¨¨”",
    "vi": "%s2%t4%z18%c1“Ha ha! Đúng là người không xuất thân từ quân đội có khác...”"
  },
  {
    "id": "stage15:3884",
    "token": 3884,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“唉¨¨我们补给完还是赶紧跟上吧！”",
    "vi": "%s2%t4%z18%c1“Haiz... Tiếp tế xong thì mau đuổi theo họ thôi!”"
  },
