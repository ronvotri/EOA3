  {
    "id": "stage15:2694",
    "token": 2694,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“雷丝曼大人，我带人来投效您了！”",
    "vi": "%s2%t4%z18%c1“Thưa ngài Resman, tôi đã dẫn người tới đầu quân!”"
  },
  {
    "id": "stage15:2719",
    "token": 2719,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“哦！这不是玛西亚的爱将洁莉吗？”",
    "vi": "%s2%t4%z18%c1“Ồ! Chẳng phải Jeli, tướng tâm phúc của Marcia sao?”"
  },
  {
    "id": "stage15:2730",
    "token": 2730,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“是什么风把你给吹来了！”",
    "vi": "%s2%t4%z18%c1“Ngọn gió nào đưa ngươi đến đây vậy?”"
  },
  {
    "id": "stage15:2755",
    "token": 2755,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“雷丝曼女帝，千万别这么说。”",
    "vi": "%s2%t4%z18%c1“Xin Nữ hoàng Resman đừng nói thế ạ.”"
  },
  {
    "id": "stage15:2766",
    "token": 2766,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“最近贝力欧的战况越来越糟，玛西亚首领的军%N队接连好几次都败给邦联军。”",
    "vi": "%s2%t4%z18%c1“Tình hình chiến sự ở Belio càng lúc càng tệ.%NQuân của thủ lĩnh Marcia liên tiếp thua quân Liên bang.”"
  },
  {
    "id": "stage15:2777",
    "token": 2777,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“而首领又不许我们喝下力量之泉，所以¨¨¨”",
    "vi": "%s2%t4%z18%c1“Mà thủ lĩnh lại cấm chúng tôi uống Suối Sức Mạnh, nên...”"
  },
  {
    "id": "stage15:2802",
    "token": 2802,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“哼！胆小鬼。”",
    "vi": "%s2%t4%z18%c1“Hừ! Đúng là đồ nhát gan!”"
  },
  {
    "id": "stage15:2813",
    "token": 2813,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“拥有力量之泉的人却不敢喝，独占了一座天使%N之泉就这样白白放着浪费。”",
    "vi": "%s2%t4%z18%c1“Có Suối Sức Mạnh mà không dám uống,%Nđộc chiếm cả một suối Thiên Sứ rồi bỏ phí!”"
  },
  {
    "id": "stage15:2824",
    "token": 2824,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“哼！不过不要紧，我还是会到玛雅找到其他的%N力量之泉。”",
    "vi": "%s2%t4%z18%c1“Hừ! Không sao, ta sẽ tới Maya tìm những%Nnguồn Suối Sức Mạnh khác.”"
  },
  {
    "id": "stage15:2887",
    "token": 2887,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“好，就从这里进攻。”",
    "vi": "%s2%t4%z18%c1“Được rồi, ta sẽ tấn công từ đây!”"
  },
  {
    "id": "stage15:2917",
    "token": 2917,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“敌袭！！”",
    "vi": "%s2%t4%z18%c1“Địch tập kích!!”"
  },
  {
    "id": "stage15:2967",
    "token": 2967,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“报告女敌，敌人已经进攻到这了！”",
    "vi": "%s2%t4%z18%c1“Bẩm Nữ hoàng, quân địch đã đánh đến đây rồi!”"
  },
  {
    "id": "stage15:2978",
    "token": 2978,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“我军也已经完成部署，请示出击!”",
    "vi": "%s2%t4%z18%c1“Quân ta đã bố trí xong, xin cho phép xuất kích!”"
  },
  {
    "id": "stage15:3003",
    "token": 3003,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“哼！”",
    "vi": "%s2%t4%z18%c1“Hừ!”"
  },
  {
    "id": "stage15:3014",
    "token": 3014,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“洁莉，看着吧！选择跟着我是对的。”",
    "vi": "%s2%t4%z18%c1“Jeli, cứ nhìn đi! Ngươi đã chọn đúng người để theo rồi.”"
  },
  {
    "id": "stage15:3039",
    "token": 3039,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“是！”",
    "vi": "%s2%t4%z18%c1“Vâng ạ!”"
  },
  {
    "id": "stage15:3064",
    "token": 3064,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“就让邦联军尝尝苦头吧！”",
    "vi": "%s2%t4%z18%c1“Cho quân Liên bang nếm mùi thất bại nào!”"
  },
  {
    "id": "stage15:3075",
    "token": 3075,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“传令！全军出击。”",
    "vi": "%s2%t4%z18%c1“Truyền lệnh! Toàn quân xuất kích!”"
  },
  {
    "id": "stage15:3100",
    "token": 3100,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“是！”",
    "vi": "%s2%t4%z18%c1“Tuân lệnh!”"
  },
  {
