    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“追上了。”",
    "vi": "%s2%t4%z18%c1“Đuổi kịp rồi!”"
  },
  {
    "id": "stage21:3804",
    "token": 3804,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“洁莉妹子，你很会跑耶！”",
    "vi": "%s2%t4%z18%c1“Em Jeli, cô chạy giỏi thật đấy!”"
  },
  {
    "id": "stage21:3829",
    "token": 3829,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“呼¨¨呼¨¨你要就正大光明打一场！”",
    "vi": "%s2%t4%z18%c1“Hộc... hộc... giỏi thì đứng lại đấu đàng hoàng đi!”"
  },
  {
    "id": "stage21:3840",
    "token": 3840,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“累死本小姐了¨¨呼¨呼¨¨¨”",
    "vi": "%s2%t4%z18%c1“Mệt chết tôi rồi... hộc... hộc...”"
  },
  {
    "id": "stage21:3870",
    "token": 3870,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“哼！不好玩，都追得这么快。”",
    "vi": "%s2%t4%z18%c1“Hừ! Chán quá, đuổi kịp nhanh thế!”"
  },
  {
    "id": "stage21:3881",
    "token": 3881,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“这么爱打就来打吧！”",
    "vi": "%s2%t4%z18%c1“Thích đánh lắm thì nhào vào đây!”"
  },
  {
    "id": "stage21:3986",
    "token": 3986,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“纱玲长老派我们来协助各位。”",
    "vi": "%s2%t4%z18%c1“Trưởng lão Shaling cử chúng tôi đến giúp các vị.”"
  },
  {
    "id": "stage21:3997",
    "token": 3997,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“请各位多多指教。”",
    "vi": "%s2%t4%z18%c1“Mong được mọi người chỉ giáo và giúp đỡ!”"
  },
  {
    "id": "stage21:4022",
    "token": 4022,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“太好了。”",
    "vi": "%s2%t4%z18%c1“Tốt quá!”"
  },
  {
    "id": "stage21:4033",
    "token": 4033,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“那就麻烦你们了！”",
    "vi": "%s2%t4%z18%c1“Vậy nhờ các cậu nhé!”"
  },
