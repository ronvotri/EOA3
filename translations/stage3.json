  {
    "id": "stage3:1907",
    "token": 1907,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“这一带不管怎么绕都有敌军，该怎么办呢？”",
    "vi": "%s2%t4%z18%c1“Đi vòng hướng nào cũng gặp quân địch. Giờ phải làm sao đây?”"
  },
  {
    "id": "stage3:1921",
    "token": 1921,
    "call": "PlayMusic",
    "argument": 0,
    "mode": "locked",
    "source": "Danger.wav",
    "vi": ""
  },
  {
    "id": "stage3:1944",
    "token": 1944,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“我观察过了，这里的敌人是这附近最少的。%N我们冲过去吧！”",
    "vi": "%s2%t4%z18%c1“Mình quan sát rồi, quân địch ở đây ít nhất vùng này.%NHay cứ xông qua đi!”"
  },
  {
    "id": "stage3:1989",
    "token": 1989,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z26%c1“冲啊！！！”",
    "vi": "%s2%t4%z26%c1“Xông lên!!!”"
  },
  {
    "id": "stage3:2033",
    "token": 2033,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z22%c1“嗯？！什么人！！”",
    "vi": "%s2%t4%z22%c1“Hả!? Ai đó!?”"
  },
  {
    "id": "stage3:2077",
    "token": 2077,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“希蜜¨¨”",
    "vi": "%s2%t4%z18%c1“Shimi...”"
  },
  {
    "id": "stage3:2109",
    "token": 2109,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“什么事？”",
    "vi": "%s2%t4%z18%c1“Gì thế?”"
  },
  {
    "id": "stage3:2134",
    "token": 2134,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“你可以不用喊那么大声¨¨”",
    "vi": "%s2%t4%z18%c1“Cậu không cần hét to đến thế đâu...”"
  },
  {
    "id": "stage3:2184",
    "token": 2184,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z20%c1“你们几个鬼鬼祟祟在做什么？%N%t4%z25%c1快出来！”",
    "vi": "%s2%t4%z20%c1“Mấy người lén lút làm gì ở đó?%N%t4%z25%c1Ra đây mau!”"
  },
  {
    "id": "stage3:2241",
    "token": 2241,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“啊¨被发现了¨¨，对不起¨¨¨”",
    "vi": "%s2%t4%z18%c1“Á... Bị phát hiện rồi... Xin lỗi mà...”"
  },
