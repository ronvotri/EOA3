  {
    "id": "stage8:2344",
    "token": 2344,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“总算来到香格里拉的边境了。”",
    "vi": "%s2%t4%z18%c1“Cuối cùng cũng đến biên giới Shangri-La rồi!”"
  },
  {
    "id": "stage8:2355",
    "token": 2355,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“只是没有邦联议会的国信，要过境恐怕有点难。”",
    "vi": "%s2%t4%z18%c1“Nhưng không có quốc thư của Hội đồng Liên bang, e là khó qua cửa ải này.”"
  },
  {
    "id": "stage8:2380",
    "token": 2380,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“唉¨¨¨说起来真是可悲呀！”",
    "vi": "%s2%t4%z18%c1“Haiz... Nghĩ lại mà buồn quá đi!”"
  },
  {
    "id": "stage8:2405",
    "token": 2405,
    "call": "Say",
    "argument": 1,
    "mode": "locked",
    "source": "%s2%t4%z18%c1“¨¨¨¨”",
    "vi": ""
  },
  {
    "id": "stage8:2416",
    "token": 2416,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“还不都是你害的！”",
    "vi": "%s2%t4%z18%c1“Chẳng phải tất cả đều tại cậu sao!”"
  },
  {
    "id": "stage8:2441",
    "token": 2441,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“对、对不起啦！”",
    "vi": "%s2%t4%z18%c1“Mình... mình xin lỗi mà!”"
  },
  {
    "id": "stage8:2466",
    "token": 2466,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“算了，只能先进去问问看吧！”",
    "vi": "%s2%t4%z18%c1“Thôi, cứ vào hỏi thử xem đã!”"
  },
  {
    "id": "stage8:2572",
    "token": 2572,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“站住！”",
    "vi": "%s2%t4%z18%c1“Đứng lại!”"
  },
  {
    "id": "stage8:2583",
    "token": 2583,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“你们是谁？有什么事情吗？”",
    "vi": "%s2%t4%z18%c1“Các người là ai? Đến đây có việc gì?”"
  },
  {
    "id": "stage8:2608",
    "token": 2608,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“您好！我们是爱尔达邦联所派遣的特使，%N有要事需向贵国女皇商讨。”",
    "vi": "%s2%t4%z18%c1“Xin chào! Chúng tôi là đặc sứ Liên bang Elda,%Ncó việc quan trọng cần trình Nữ hoàng quý quốc.”"
  },
  {
    "id": "stage8:2633",
    "token": 2633,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“爱尔达特使！？”",
    "vi": "%s2%t4%z18%c1“Đặc sứ Elda sao!?”"
  },
  {
    "id": "stage8:2644",
    "token": 2644,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“有正式的关文吗？”",
    "vi": "%s2%t4%z18%c1“Có giấy thông hành chính thức không?”"
  },
  {
    "id": "stage8:2669",
    "token": 2669,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“是这样的，原本有一封国信呈给贵国女皇。”",
    "vi": "%s2%t4%z18%c1“Chuyện là thế này. Chúng tôi vốn có quốc thư trình Nữ hoàng.”"
  },
  {
    "id": "stage8:2680",
    "token": 2680,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“但是不久前在路上遇上了强盗，所以¨¨¨¨”",
    "vi": "%s2%t4%z18%c1“Nhưng dọc đường lại gặp bọn cướp, nên...”"
  },
  {
    "id": "stage8:2705",
    "token": 2705,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“哈哈哈～～”",
    "vi": "%s2%t4%z18%c1“Ha ha ha!”"
  },
  {
    "id": "stage8:2716",
    "token": 2716,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“麻烦下次找个好一点的理由吧，%N你这招太老套啦！”",
    "vi": "%s2%t4%z18%c1“Lần sau bịa lý do nào khá hơn một chút đi!%NTrò này cũ rích rồi!”"
  },
  {
    "id": "stage8:2741",
    "token": 2741,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“我们说的都是真的呀！”",
    "vi": "%s2%t4%z18%c1“Nhưng chúng tôi nói thật mà!”"
  },
  {
    "id": "stage8:2766",
    "token": 2766,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“走开走开，没空陪你们。”",
    "vi": "%s2%t4%z18%c1“Đi đi! Bọn ta không rảnh tiếp các người!”"
  },
  {
    "id": "stage8:2777",
    "token": 2777,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“别再来妨碍我们，否则别怪我们不客气。”",
    "vi": "%s2%t4%z18%c1“Đừng đến quấy rầy nữa, không thì đừng trách bọn ta!”"
  },
  {
    "id": "stage8:2802",
    "token": 2802,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“我们确实是爱尔达特使，请你务必相信。”",
    "vi": "%s2%t4%z18%c1“Chúng tôi thật sự là đặc sứ Elda. Xin hãy tin chúng tôi!”"
  },
  {
    "id": "stage8:2816",
    "token": 2816,
    "call": "PlayMusic",
    "argument": 0,
    "mode": "locked",
    "source": "STOP",
    "vi": ""
  },
  {
    "id": "stage8:2832",
    "token": 2832,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“没有关文，恕难照办！”",
    "vi": "%s2%t4%z18%c1“Không có giấy tờ, xin thứ lỗi! Không thể cho qua!”"
  },
  {
    "id": "stage8:2843",
    "token": 2843,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“如果你们还是坚持不肯离开¨¨¨”",
    "vi": "%s2%t4%z18%c1“Nếu các người vẫn nhất quyết không chịu đi...”"
  },
  {
    "id": "stage8:2852",
    "token": 2852,
    "call": "PlayMusic",
    "argument": 0,
    "mode": "locked",
    "source": "Battle_S2.wav",
    "vi": ""
  },
  {
    "id": "stage8:2859",
    "token": 2859,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“来人呀！”",
    "vi": "%s2%t4%z18%c1“Người đâu!”"
  },
  {
    "id": "stage8:2870",
    "token": 2870,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“将她们全部拿下。”",
    "vi": "%s2%t4%z18%c1“Bắt tất cả bọn chúng lại!”"
  },
  {
    "id": "stage8:2927",
    "token": 2927,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“这¨¨¨太不讲理了！”",
    "vi": "%s2%t4%z18%c1“Sao... sao các người vô lý thế!”"
  },
  {
    "id": "stage8:2938",
    "token": 2938,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“可恶，我们也出击！”",
    "vi": "%s2%t4%z18%c1“Đáng ghét! Bọn mình cũng phải đánh thôi!”"
  },
