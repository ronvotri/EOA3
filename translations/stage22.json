    "token": 4016,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“这样我了解了。”",
    "vi": "%s2%t4%z18%c1“Vâng, tôi hiểu rồi.”"
  },
  {
    "id": "stage22:4041",
    "token": 4041,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“你们就早点回叶虏鞑吧！”",
    "vi": "%s2%t4%z18%c1“Các ngươi nên sớm trở về Yeluda đi!”"
  },
  {
    "id": "stage22:4066",
    "token": 4066,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“长老，那么丽凤¨¨¨¨”",
    "vi": "%s2%t4%z18%c1“Thưa Trưởng lão, vậy còn Lifeng...?”"
  },
  {
    "id": "stage22:4091",
    "token": 4091,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“她正在进行成为绝世强者必经的试炼，什么时候%N能见到她，就看她需要多少时日才能通过试炼。”",
    "vi": "%s2%t4%z18%c1“Cô ấy đang trải qua thử thách để trở thành cao thủ.%NKhi nào gặp lại còn tùy cô ấy vượt qua nhanh hay chậm.”"
  },
  {
    "id": "stage22:4116",
    "token": 4116,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“原来如此¨¨¨，%N那么我们就先回爱尔达了。”",
    "vi": "%s2%t4%z18%c1“Ra là vậy...%NVậy chúng tôi về Elda trước.”"
  },
  {
    "id": "stage22:4141",
    "token": 4141,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“祝你们一路顺风。”",
    "vi": "%s2%t4%z18%c1“Chúc các ngươi lên đường bình an.”"
  },
