    "id": "stage22:4600",
    "token": 4600,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“哼！算了，我的士兵都一个个离开了，%N要杀我就趁现在吧！”",
    "vi": "%s2%t4%z18%c1“Hừ, mặc kệ! Binh sĩ của ta đã bỏ đi hết rồi.%NMuốn giết ta thì đây là lúc đấy!”"
  },
