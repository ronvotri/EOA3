    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“我们不是为了这个事情来的。”",
    "vi": "%s2%t4%z18%c1“Chúng tôi không đến đây vì chuyện đó.”"
