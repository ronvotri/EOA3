    "token": 4589,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“你们到这里来做什么？”",
    "vi": "%s2%t4%z18%c1“Các ngươi đến đây làm gì?”"
  },
