    "token": 4711,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“我是毁了你国家的人，为什么还要帮助我！”",
    "vi": "%s2%t4%z18%c1“Chính ta đã hủy hoại quê hương ngươi! Sao ngươi còn muốn giúp ta?”"
