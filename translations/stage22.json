    "token": 4794,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“哼！那好，我也就勉强的收下了！”",
    "vi": "%s2%t4%z18%c1“Hừ! Vậy được, ta miễn cưỡng nhận!”"
  },
  {
    "id": "stage22:4805",
    "token": 4805,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“如果没其他的事情就请回吧！”",
    "vi": "%s2%t4%z18%c1“Nếu không còn việc gì thì mời về!”"
  },
  {
    "id": "stage22:4816",
    "token": 4816,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“我要去神殿，不送你们了！”",
    "vi": "%s2%t4%z18%c1“Ta phải đến ngôi đền, không tiễn các ngươi đâu!”"
