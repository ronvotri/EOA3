    "token": 4650,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“那你们有什么事情就快说吧！”",
    "vi": "%s2%t4%z18%c1“Vậy có việc gì thì nói mau đi!”"
