    "id": "stage22:4522",
    "token": 4522,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“我可以偷偷看一下贝力欧女帝的房间长怎样%N吗？”",
    "vi": "%s2%t4%z18%c1“Mình lén ngó phòng ngủ của Nữ hoàng Belio%Nột chút được không nhỉ?”"
  },
