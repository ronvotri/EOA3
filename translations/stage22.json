    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“哇！一路走到敌方重地却完全没人防守呢！”",
    "vi": "%s2%t4%z18%c1“Trời! Vào tận hang ổ quân địch mà chẳng thấy ai canh gác!”"
  },
