  {
    "id": "stage16:5232",
    "token": 5232,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z24%c1“啊！敌军。”",
    "vi": "%s2%t4%z24%c1“Á! Quân địch!”"
  },
  {
    "id": "stage16:5264",
    "token": 5264,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“可恶，被包围了¨¨¨”",
    "vi": "%s2%t4%z18%c1“Chết rồi, bị bao vây mất rồi...”"
  },
  {
    "id": "stage16:5352",
    "token": 5352,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“糟了，盈月她们有危险。”",
    "vi": "%s2%t4%z18%c1“Không ổn! Yingyue và mọi người gặp nguy rồi!”"
  },
  {
    "id": "stage16:5377",
    "token": 5377,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“呦～她们两个打算攻下整座城堡呀！？”",
    "vi": "%s2%t4%z18%c1“Ái chà, hai người đó định hạ cả tòa thành sao!?”"
  },
  {
    "id": "stage16:5388",
    "token": 5388,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“那就看她们的罗！”",
    "vi": "%s2%t4%z18%c1“Cứ để họ tự lo đi!”"
  },
  {
    "id": "stage16:5413",
    "token": 5413,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“不行，我还没当寨主之前不能让盈月死。”",
    "vi": "%s2%t4%z18%c1“Không! Mình còn chưa làm trại chủ, Yingyue không được chết!”"
  },
  {
    "id": "stage16:5424",
    "token": 5424,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“我要去帮忙。”",
    "vi": "%s2%t4%z18%c1“Mình phải đến giúp!”"
  },
  {
    "id": "stage16:5496",
    "token": 5496,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“盈月大人，我来了！！”",
    "vi": "%s2%t4%z18%c1“Đại ca Yingyue! Em đến đây!!”"
  },
  {
    "id": "stage16:5521",
    "token": 5521,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“你们怎么来了？”",
    "vi": "%s2%t4%z18%c1“Các ngươi đến đây làm gì?”"
  },
  {
    "id": "stage16:5546",
    "token": 5546,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“没办法，最近战争太多，%N根本没东西可以抢！”",
    "vi": "%s2%t4%z18%c1“Dạo này chiến tranh khắp nơi, chẳng còn%Nthứ gì để cướp nữa!”"
  },
  {
    "id": "stage16:5557",
    "token": 5557,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“刚才经过附近正想溜进城里偷东西，正好听到%N盈月大人的声音，所以就赶过来看看情况了！”",
    "vi": "%s2%t4%z18%c1“Bọn em đi ngang, định lẻn vào thành kiếm ít đồ.%NVừa nghe tiếng đại ca là chạy tới ngay!”"
  },
  {
    "id": "stage16:5582",
    "token": 5582,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“很好，来的正是时候。”",
    "vi": "%s2%t4%z18%c1“Tốt lắm! Đến đúng lúc đấy!”"
  },
  {
    "id": "stage16:5593",
    "token": 5593,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“就给她们一点颜色瞧瞧！”",
    "vi": "%s2%t4%z18%c1“Cho bọn chúng biết tay nào!”"
  },
  {
    "id": "stage16:5607",
    "token": 5607,
    "call": "MessageBox",
    "argument": 0,
    "mode": "translate",
    "source": "夏美加入队伍",
    "vi": "Xia Mei gia nhập đội."
  },
  {
    "id": "stage16:5633",
    "token": 5633,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“都到齐了吗？”",
    "vi": "%s2%t4%z18%c1“Đủ mặt cả rồi chứ?”"
  },
  {
    "id": "stage16:5644",
    "token": 5644,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“那就等死吧！”",
    "vi": "%s2%t4%z18%c1“Vậy thì chuẩn bị chết đi!”"
  },
  {
    "id": "stage16:5655",
    "token": 5655,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“我可不会像玛西亚或克诺依德那么没用的。”",
    "vi": "%s2%t4%z18%c1“Ta đâu vô dụng như Marcia hay Konoid!”"
  },
  {
