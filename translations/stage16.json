  },
  {
    "id": "stage16:3919",
    "token": 3919,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“嘿嘿～”",
    "vi": "%s2%t4%z18%c1“Hê hê~”"
  },
  {
    "id": "stage16:3951",
    "token": 3951,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“呼呼¨¨”",
    "vi": "%s2%t4%z18%c1“Hộc... hộc...”"
  },
  {
    "id": "stage16:3962",
    "token": 3962,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“莉娜¨¨等我一下啦¨¨¨”",
    "vi": "%s2%t4%z18%c1“Lina... đợi mình với mà...”"
  },
  {
    "id": "stage16:3987",
    "token": 3987,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“她往那边去了，我们快追。”",
    "vi": "%s2%t4%z18%c1“Cậu ấy chạy hướng kia! Mau đuổi theo!”"
  },
  {
    "id": "stage16:4012",
    "token": 4012,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“还要追吗¨¨¨”",
    "vi": "%s2%t4%z18%c1“Vẫn phải đuổi tiếp sao...?”"
  },
  {
    "id": "stage16:4023",
    "token": 4023,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“妮雅他们还没跟来呐¨¨”",
    "vi": "%s2%t4%z18%c1“Niya và mọi người còn chưa theo kịp mà...”"
  },
  {
    "id": "stage16:4048",
    "token": 4048,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“不来你就自己待着。”",
    "vi": "%s2%t4%z18%c1“Không theo thì cậu cứ ở lại một mình đi!”"
  },
  {
    "id": "stage16:4073",
    "token": 4073,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“好啦¨¨不要丢下我，等等我呐¨¨”",
    "vi": "%s2%t4%z18%c1“Được rồi mà... đừng bỏ mình lại! Đợi với...”"
  },
  {
    "id": "stage16:4124",
    "token": 4124,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“呼呼¨¨¨¨”",
    "vi": "%s2%t4%z18%c1“Hộc... hộc...”"
  },
  {
    "id": "stage16:4189",
    "token": 4189,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“呼呼¨¨真是的¨¨¨¨”",
    "vi": "%s2%t4%z18%c1“Hộc... hộc... thiệt tình...”"
  },
  {
    "id": "stage16:4294",
    "token": 4294,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“这里！”",
    "vi": "%s2%t4%z18%c1“Ở đây này!”"
  },
  {
    "id": "stage16:4332",
    "token": 4332,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“啊！等我。”",
    "vi": "%s2%t4%z18%c1“Á! Chờ mình nữa!”"
  },
  {
    "id": "stage16:4449",
    "token": 4449,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“喔！？人都不见了！”",
    "vi": "%s2%t4%z18%c1“Ủa!? Mọi người biến đâu hết rồi!”"
  },
  {
    "id": "stage16:4460",
    "token": 4460,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“跑的还真快¨¨¨果真是有好东西瞒着我们。”",
    "vi": "%s2%t4%z18%c1“Chạy nhanh thật đấy... Chắc có món ngon gì đang giấu mình đây!”"
  },
  {
    "id": "stage16:4471",
    "token": 4471,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“我们往这边！”",
    "vi": "%s2%t4%z18%c1“Mình đi lối này!”"
  },
  {
    "id": "stage16:4537",
    "token": 4537,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“奇怪，她们往哪去了？”",
    "vi": "%s2%t4%z18%c1“Lạ thật, họ chạy đâu mất rồi?”"
  },
  {
    "id": "stage16:4614",
    "token": 4614,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“盈月老大¨¨¨”",
    "vi": "%s2%t4%z18%c1“Đại ca Yingyue...”"
  },
  {
    "id": "stage16:4646",
    "token": 4646,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“什么事吗？”",
    "vi": "%s2%t4%z18%c1“Có chuyện gì thế?”"
  },
  {
    "id": "stage16:4671",
    "token": 4671,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“我觉得背后凉凉地¨¨¨”",
    "vi": "%s2%t4%z18%c1“Sao tự nhiên em thấy lạnh cả sống lưng...”"
  },
  {
    "id": "stage16:4682",
    "token": 4682,
    "call": "Say",
    "argument": 1,
    "mode": "translate",
    "source": "%s2%t4%z18%c1“好像有倒楣的事要发生了¨¨¨”",
    "vi": "%s2%t4%z18%c1“Hình như sắp có chuyện xui xẻo xảy ra...”"
  },
